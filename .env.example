# Resend API Key (Get yours at https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Recipient email address where contact inquiries are delivered
# (Defaults to your Resend account email tech.desertwhales@gmail.com for sandbox/testing)
CONTACT_RECIPIENT_EMAIL=tech.desertwhales@gmail.com

# Verified sender address in Resend (default for testing is onboarding@resend.dev)
# Once your domain desertwhales.tech is verified in Resend, use e.g. "DW Tech <contact@desertwhales.tech>"
RESEND_FROM_EMAIL=DW Tech Inquiries <onboarding@resend.dev>
