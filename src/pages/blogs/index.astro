---
import Layout from "../../layouts/Layout.astro";
import { blogPosts, companyIdentity, siteUrl } from "@/lib/site-data";
import { section, sectionLabel, shell, button } from "@/lib/styles";
import { ArrowUpRight } from "@/components/layout/icons";

const pageTitle = "Insights & Technology Blog | DW Tech Dubai & GCC";
const pageDescription =
  "Technical perspectives, enterprise AI adoption playbooks, custom software architecture, and digital transformation insights from DW Tech engineers in Dubai and Riyadh.";

const blogDirectorySchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "DW Tech Insights & Technology Blog",
  url: `${siteUrl}/blogs`,
  description: pageDescription,
  publisher: {
    "@type": "Organization",
    name: companyIdentity.name,
    url: siteUrl,
  },
  blogPost: blogPosts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.title,
    description: post.excerpt,
    url: `${siteUrl}/blogs/${post.slug}`,
    datePublished: post.publishedDate,
    author: {
      "@type": "Person",
      name: post.author,
    },
  })),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={blogDirectorySchema}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Blogs", item: "/blogs" },
  ]}
>
  <main class="bg-night text-white overflow-hidden">
    {/* ── Hero Section (Matches About & Portfolio UI/UX) ── */}
    <section
      class="relative pt-[160px] pb-[50px] bg-[radial-gradient(ellipse_at_80%_20%,rgba(176,99,255,0.22),transparent_50%),#05040e]"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(176,99,255,.3)_0_1px,transparent_1.3px)] bg-[length:64px_64px] opacity-15"
        aria-hidden="true"
      >
      </div>

      <div class={`${shell} relative z-[1]`}>
        <nav
          aria-label="Breadcrumb"
          class="mb-8 flex items-center gap-2 text-xs text-[#a19bad]"
        >
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="opacity-40">/</span>
          <span class="text-orchid">Blogs & Insights</span>
        </nav>

        <h1
          class="text-[clamp(3.7rem,5vw,6rem)] leading-[0.98] tracking-tight max-w-[1100px] mb-8 text-white"
        >
          Architectural thinking for <span class="text-orchid"
            >intelligent business.</span
          >
        </h1>

        <p
          class="max-w-[820px] text-[clamp(1.05rem,1.4vw,1rem)] leading-[1.65] text-[#cfcad8] mb-10"
        >
          Technical perspectives, systems engineering playbooks, and research on
          enterprise AI adoption, multi-agent boundaries, and high-performance
          digital platforms across Dubai, Riyadh, India, and Europe.
        </p>
      </div>
    </section>

    {
      /* ── Articles Section: Clean Light Theme matching /portfolio & /about ── */
    }
    <section
      class={`${section} relative bg-[#faf9fd] text-[#05040e] border-t border-black/5`}
      id="articles"
    >
      <div class={shell}>
        <div class="mb-14 lg:mb-16 text-center max-w-[820px] mx-auto">
          <h2
            class="text-[clamp(2.5rem,4.5vw,4.5rem)] text-[#05040e] tracking-tight font-normal"
          >
            Read our latest perspectives
          </h2>
          <p class="mt-4 text-base lg:text-lg text-[#615a6e] leading-relaxed">
            Executive essays and architectural field notes exploring production
            AI reliability, multi-agent state machines, and modern digital
            platforms.
          </p>
        </div>

        {/* ── 3-Column Clean Flat Cards Grid (ZERO SHADOWS) ── */}
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 lg:gap-8"
        >
          {
            blogPosts.map((post) => {
              const badgeLabel = post.badge || "DRAFT PERSPECTIVE";
              const tagList =
                post.tags && post.tags.length > 0
                  ? post.tags
                  : [post.category.toUpperCase()];

              return (
                <article class="group relative flex flex-col justify-between rounded-[24px] bg-white border border-[#e2dded] p-7 sm:p-8 hover:border-[#311959] transition-colors duration-200 shadow-none">
                  {/* Top Header Row: Pill Badge + Read Time */}
                  <div>
                    <div class="flex items-center justify-between gap-3 mb-6">
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-mono tracking-wider uppercase rounded-md bg-[#f4effc] text-[#311959] border border-[#311959]/20 font-semibold">
                        <span class="size-1.5 rounded-full bg-[#311959]" />
                        {badgeLabel}
                      </span>
                      <span class="text-xs font-mono tracking-wider uppercase text-[#888194] font-medium">
                        {post.readTime}
                      </span>
                    </div>

                    {/* Headline / Title */}
                    <h3 class="text-xl sm:text-[1.38rem] font-bold text-[#0c0916] tracking-tight leading-[1.28] mb-4 group-hover:text-[#311959] transition-colors font-manrope">
                      <a
                        href={`/blogs/${post.slug}`}
                        class="focus:outline-none"
                      >
                        {post.title}
                      </a>
                    </h3>

                    {/* Description / Subtitle */}
                    <p class="text-sm sm:text-[0.92rem] text-[#5e5868] leading-[1.65] mb-8 font-normal line-clamp-4">
                      {post.subtitle || post.excerpt}
                    </p>
                  </div>

                  {/* Bottom Divider & Tags + Read perspective */}
                  <div class="mt-auto pt-5 border-t border-black/[0.07] flex items-end justify-between gap-4">
                    {/* Left: Tags formatted in 2 stacked uppercase mono lines */}
                    <div class="text-[0.7rem] font-mono font-medium tracking-wider text-[#857f92] uppercase leading-relaxed">
                      {tagList.map((tag, idx) => (
                        <div>
                          {tag}
                          {idx < tagList.length - 1 ? " ·" : ""}
                        </div>
                      ))}
                    </div>

                    {/* Right: Read perspective with ↗ arrow */}
                    <a
                      href={`/blogs/${post.slug}`}
                      class="shrink-0 inline-flex items-center gap-1.5 text-xs font-semibold text-[#311959] group-hover:text-[#311959] transition-colors pb-0.5"
                    >
                      <span>Read perspective</span>
                      <ArrowUpRight className="size-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 text-[#311959]" />
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
