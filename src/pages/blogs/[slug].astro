---
import Layout from "../../layouts/Layout.astro";
import { blogPosts, companyIdentity, siteUrl } from "@/lib/site-data";
import { section, sectionLabel, shell, button } from "@/lib/styles";
import { ArrowUpRight, ArrowRight } from "@/components/layout/icons";
import {
  Calendar,
  Clock,
  Sparkles,
  CheckCircle2,
  ShieldCheck,
  Building,
} from "lucide-react";

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = blogPosts.find((p) => p.slug === slug);

if (!post) {
  return Astro.redirect("/blogs");
}

const pageTitle = `${post.title} | DW Tech`;
const pageDescription = post.excerpt;

// Article + FAQ Schema for AEO & Google Rich Results
const articleSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.title,
    description: post.excerpt,
    datePublished: post.publishedDate,
    dateModified: post.publishedDate,
    mainEntityOfPage: `${siteUrl}/blogs/${post.slug}`,
    author: {
      "@type": "Person",
      name: post.author,
      jobTitle: post.authorRole,
    },
    publisher: {
      "@type": "Organization",
      name: companyIdentity.name,
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: `${siteUrl}/icon.png`,
      },
    },
    about: {
      "@type": "Thing",
      name: post.category,
    },
    spatialCoverage: {
      "@type": "Place",
      name: post.geoRegion,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: post.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];

const otherPosts = blogPosts.filter((p) => p.slug !== slug);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  author={post.author}
  ogType="article"
  schema={articleSchema}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Blogs", item: "/blogs" },
    { name: post.title, item: `/blogs/${post.slug}` },
  ]}
>
  <main class="bg-night text-white overflow-hidden">
    {/* ── Article Header (Matches About & Portfolio UI/UX) ── */}
    <article>
      <header
        class="relative pt-[160px] pb-[80px] overflow-hidden text-white"
      >
        {/* Banner image under the 90% black banner */}
        <div class="absolute inset-0 z-0">
          <img
            src="/banners/blogs-banner.webp"
            alt=""
            class="w-full h-full object-cover object-center"
            loading="eager"
          />
        </div>

        {/* Solid black banner area with 90% opacity (no gradients) */}
        <div
          class="absolute inset-0 z-[1] bg-black/90 pointer-events-none"
          aria-hidden="true"
        >
        </div>

        <div class={`${shell} relative z-[2] max-w-[900px]`}>
          <nav
            aria-label="Breadcrumb"
            class="mb-6 flex flex-wrap items-center gap-2 text-xs text-[#a19bad]"
          >
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="opacity-40">/</span>
            <a href="/blogs" class="hover:text-white transition-colors"
              >Blogs</a
            >
            <span class="opacity-40">/</span>
            <span class="text-orchid line-clamp-1"
              >{post.title}</span
            >
          </nav>

          <div
            class="flex flex-wrap items-center gap-3 mb-6 text-xs text-[#cfcad8]"
          >
            <span
              class="rounded-md bg-orchid/20 px-2.5 py-1 font-semibold text-orchid border border-orchid/30 font-mono uppercase tracking-wider text-[11px]"
            >
              {post.badge || post.category}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Calendar className="size-3.5 text-orchid" />
              {post.publishedDate}
            </span>
            <span class="inline-flex items-center gap-1">
              <Clock className="size-3.5 text-orchid" />
              {post.readTime}
            </span>
            <span class="opacity-30">·</span>
            <span class="text-[#cfcad8] font-medium">{post.geoRegion}</span>
          </div>

          <h1
            class="text-[clamp(2.5rem,5vw,4.8rem)] leading-[1.05] tracking-tight mb-6 text-white"
          >
            {post.title}
          </h1>

          <p
            class="text-[clamp(1.1rem,1.5vw,1.35rem)] leading-relaxed text-[#cfcad8] mb-8 font-normal"
          >
            {post.subtitle}
          </p>

          <div
            class="flex items-center justify-between border-t border-white/15 pt-6"
          >
            <div class="flex items-center gap-3">
              <div
                class="size-10 rounded-full bg-orchid/20 border border-orchid/40 grid place-items-center text-orchid font-bold text-sm"
              >
                DW
              </div>
              <div>
                <p class="m-0 text-sm font-semibold text-white">
                  {post.author}
                </p>
                <p class="m-0 text-xs text-[#9d97a9]">
                  {post.authorRole} · Dubai HQ
                </p>
              </div>
            </div>
            <a
              href="/contact"
              class="text-xs font-semibold text-orchid hover:text-white transition-colors flex items-center gap-1"
            >
              <span>Consult with author</span>
              <ArrowRight className="size-3" />
            </a>
          </div>
        </div>
      </header>

      {/* ── Key Takeaways Box (AEO Direct Answers) ── */}
      <section class="py-10 bg-white border-y border-black/5">
        <div class={`${shell} max-w-[900px]`}>
          <div
            class="rounded-2xl border border-[#311959]/25 bg-[#faf6fe] p-6 lg:p-8"
          >
            <h2
              class="text-xs uppercase font-bold tracking-wider text-[#311959] mb-4 flex items-center gap-2 font-mono"
            >
              <Sparkles className="size-4 text-[#311959]" />
              <span>Key Strategic Takeaways & Executive Overview</span>
            </h2>
            <ul
              class="space-y-3 m-0 p-0 list-none text-sm lg:text-base text-[#383244]"
            >
              {
                post.keyTakeaways.map((takeaway) => (
                  <li class="flex items-start gap-3">
                    <CheckCircle2 className="size-4 text-[#311959] shrink-0 mt-1" />
                    <span class="leading-relaxed">{takeaway}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      {/* ── Article Content ── */}
      <section class="py-16 bg-[#faf9fd]">
        <div class={`${shell} max-w-[900px]`}>
          <div class="space-y-12">
            {
              post.contentSections.map((sec) => (
                <div>
                  <h2 class="text-2xl lg:text-3xl font-bold text-[#05040e] tracking-tight mb-4 font-manrope">
                    {sec.heading}
                  </h2>
                  <p
                    class="text-base lg:text-lg leading-[1.78] text-[#4d4758] m-0 font-sans"
                    set:html={sec.body}
                  />
                </div>
              ))
            }
          </div>

          {/* ── Embedded FAQ Section for Answer Engines ── */}
          {
            post.faq && post.faq.length > 0 && (
              <div class="mt-16 rounded-2xl border border-black/[0.08] bg-white p-8">
                <h3 class="text-xl font-bold text-[#05040e] mb-6 pb-3 border-b border-black/[0.07] flex items-center gap-2 font-manrope">
                  <ShieldCheck className="size-5 text-[#311959]" />
                  <span>Frequently Asked Questions</span>
                </h3>
                <div class="space-y-6">
                  {post.faq.map((item) => (
                    <div>
                      <h4 class="text-base font-semibold text-[#05040e] mb-2 font-manrope">
                        {item.question}
                      </h4>
                      <p class="text-sm leading-relaxed text-[#5e5868] m-0 font-sans">
                        {item.answer}
                      </p>
                    </div>
                  ))}
                </div>
              </div>
            )
          }

          {/* ── Regional Regulatory Context ── */}
          <div
            class="mt-12 rounded-xl border border-black/[0.07] bg-white p-5 text-xs text-[#736c7e] flex items-center gap-3"
          >
            <Building className="size-5 text-[#311959] shrink-0" />
            <span>
              This analysis applies to operational and legal environments across
              the United Arab Emirates (Dubai, Abu Dhabi), the Kingdom of Saudi
              Arabia (Riyadh), India, and European digital regulatory perimeters.
            </span>
          </div>
        </div>
      </section>
    </article>

    {/* ── Related Articles (Clean Flat Cards) ── */}
    {
      otherPosts.length > 0 && (
        <section class="py-16 bg-white border-t border-black/5">
          <div class={`${shell} max-w-[900px]`}>
            <p class={sectionLabel}>Further Reading</p>
            <h2 class="text-2xl lg:text-3xl font-bold text-[#05040e] mb-8 font-manrope">
              Related Insights & Engineering Playbooks
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {otherPosts.slice(0, 2).map((other) => (
                <a
                  href={`/blogs/${other.slug}`}
                  class="group block rounded-2xl border border-[#e2dded] bg-[#faf9fd] p-6 transition-colors duration-200 hover:border-[#311959]"
                >
                  <span class="text-xs font-semibold text-[#311959] mb-2 block uppercase font-mono tracking-wider">
                    {other.badge || other.category} · {other.readTime}
                  </span>
                  <h3 class="text-lg font-bold text-[#05040e] group-hover:text-[#311959] transition-colors mb-2 font-manrope">
                    {other.title}
                  </h3>
                  <p class="text-xs text-[#5e5868] line-clamp-2 leading-relaxed">
                    {other.excerpt}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
</Layout>
