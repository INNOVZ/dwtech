---
import Layout from "../layouts/Layout.astro";
import { companyIdentity, contacts, locations, siteUrl } from "@/lib/site-data";
import { section, sectionLabel, shell } from "@/lib/styles";
import ContactForm from "@/components/contact/contact-form";
import { Mail, Phone, ShieldCheck, CheckCircle2 } from "lucide-react";
import { WhatsApp } from "@/components/layout/icons";

const pageTitle =
  "Contact DW Tech Dubai | Custom Software & Enterprise AI";
const pageDescription =
  "Connect with Desert Whales Technologies in Dubai, UAE for custom software development, enterprise AI automation, ERP & CRM systems, and cloud architecture.";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: pageTitle,
  url: `${siteUrl}/contact`,
  description: pageDescription,
  mainEntity: {
    "@type": "Organization",
    name: companyIdentity.name,
    telephone: contacts.phones[0]?.[1] || "+971 52 867 8679",
    email: contacts.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: "Bay Square, Business Bay",
      addressLocality: "Dubai",
      addressRegion: "Dubai",
      addressCountry: "AE",
    },
    areaServed: ["United Arab Emirates", "Saudi Arabia", "India", "Italy"],
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={contactSchema}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Contact", item: "/contact" },
  ]}
>
  <main class="bg-night text-white">
    {/* ── 1. Hero Section (Matching About & Portfolio Signature Style) ── */}
    <section
      class="relative min-h-[280px] pt-[170px] pb-[50px] overflow-hidden text-white max-[620px]:min-h-0 max-[620px]:pt-[150px] max-[620px]:pb-[70px]"
    >
      {/* Banner image under the 90% black banner */}
      <div class="absolute inset-0 z-0">
        <img
          src="/banners/contact-banner.webp"
          alt=""
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>

      {/* Solid black banner area with 90% opacity (no gradients) */}
      <div
        class="absolute inset-0 z-[1] bg-black/90 pointer-events-none"
        aria-hidden="true"
      >
      </div>

      <div class={`${shell} relative z-[2]`}>
        <h1
          class="text-[clamp(3.7rem,5vw,6rem)] leading-[0.98] tracking-tight max-w-[1100px] mb-8"
        >
          Let's build <span class="text-orchid">Beyond tomorrow</span>
        </h1>

        <p
          class="max-w-[820px] text-[clamp(1.05rem,1.4vw,1rem)] leading-[1.65] text-[#cfcad8] mb-10"
        >
          Whether evaluating private AI agent deployment, planning an enterprise
          software roadmap, or engineering high-throughput digital platforms.
        </p>

        {/* Aggregate Impact Numbers (Matches About & Portfolio) */}
      </div>
    </section>

    {/* ── 2. Editorial Contact Split Section (bg-mist text-ink) ── */}
    <section class={`${section} bg-mist text-ink`}>
      <div class={shell}>
        <h2
          class="text-[clamp(2rem,4.5vw,4.2rem)] pb-10 flex items-center justify-center leading-tight tracking-tight"
        >
          Make an Enquiry
        </h2>
        <div
          class="grid grid-cols-1 lg:grid-cols-[1.22fr_.78fr] gap-[6vw] items-start"
        >
          {/* Left Column: Direct Dialogue & Channels */}<div>
            <ContactForm client:load />
          </div>
          <div>
            {/* Direct Contact Cards */}
            <div class="space-y-4 mb-8">
              <a
                href="mailto:tech@thedesertwhales.com"
                class="flex items-center gap-4 p-4 rounded-2xl bg-white border border-black/8 hover:border-[#311959] transition-all group"
              >
                <span
                  class="size-11 rounded-xl bg-[#f4effc] text-[#311959] grid place-items-center shrink-0"
                >
                  <Mail className="size-5" />
                </span>
                <div>
                  <span
                    class="text-xs text-[#837b90] uppercase font-mono block tracking-wider"
                  >
                    Strategy Email
                  </span>
                  <strong
                    class="text-sm sm:text-base text-[#05040e] group-hover:text-[#311959] transition-colors"
                  >
                    tech@thedesertwhales.com
                  </strong>
                </div>
              </a>

              <a
                href="https://wa.me/971528678679?text=Hello%20Desert%20Whales%20Tech%2C%20I%20would%20like%20to%20discuss%20a%20project."
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-4 p-4 rounded-2xl bg-[#f0fbf4] border border-emerald-200 hover:border-emerald-500 transition-all group"
              >
                <span
                  class="size-11 rounded-xl bg-emerald-100 text-emerald-700 grid place-items-center shrink-0"
                >
                  <WhatsApp className="size-5" />
                </span>
                <div>
                  <span
                    class="text-xs text-emerald-700 uppercase font-mono block tracking-wider font-semibold"
                  >
                    Instant WhatsApp Chat
                  </span>
                  <strong
                    class="text-sm sm:text-base text-emerald-950 group-hover:text-emerald-700 transition-colors"
                  >
                    +971 52 867 8679 (Connect Now)
                  </strong>
                </div>
              </a>

              <a
                href="tel:+971528678679"
                class="flex items-center gap-4 p-4 rounded-2xl bg-white border border-black/8 hover:border-[#311959] transition-all group"
              >
                <span
                  class="size-11 rounded-xl bg-[#f4effc] text-[#311959] grid place-items-center shrink-0"
                >
                  <Phone className="size-5" />
                </span>
                <div>
                  <span
                    class="text-xs text-[#837b90] uppercase font-mono block tracking-wider"
                  >
                    Direct Phone Line
                  </span>
                  <strong
                    class="text-sm sm:text-base text-[#05040e] group-hover:text-[#311959] transition-colors"
                  >
                    +971 52 867 8679 (UAE)
                  </strong>
                </div>
              </a>
            </div>

            {/* Engagement Standards Box */}
          </div>

          {/* Right Column: High-End Contact Form */}
        </div>
      </div>
    </section>

    {
      /* ── 3. Four Markets Presence (Exact Replica of About Page Section 3) ── */
    }
    <section class={`${section} bg-white text-ink`}>
      <div class={shell}>
        <div>
          <h2 class="mb-14 max-w-100% text-[clamp(3rem,5vw,5.6rem)]">
            Close to clients across four markets.
          </h2>
        </div>

        <dl class="grid grid-cols-2 gap-x-12 max-[720px]:grid-cols-1">
          {
            locations.map(([location, role]) => (
              <div class="border-t border-black/15 py-6">
                <dt class="text-[1.25rem] font-semibold">{location}</dt>
                <dd class="mt-2 text-[#5d5867]">{role}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </main>
</Layout>
