---
import Layout from "../../layouts/Layout.astro";
import { companyIdentity, siteUrl } from "@/lib/site-data";
import { section, sectionLabel, shell } from "@/lib/styles";
import { ArrowUpRight, ArrowRight } from "@/components/layout/icons";
import {
  MessageSquareText,
  Workflow,
  CodeXml,
  Database,
  ShoppingBag,
  Sparkles,
  Smartphone,
  Cloud,
  Layers,
  Compass,
  CheckCircle2,
  ShieldCheck,
  Building,
  Bot,
  Cpu,
  GitBranch,
  Server,
} from "lucide-react";

const pageTitle =
  "Enterprise AI & Business Solutions Dubai | DW Tech";
const pageDescription =
  "Explore Desert Whales Technologies business solutions in Dubai, UAE: WhatsApp automation, enterprise ERP & CRM, AI chatbots, digital transformation, and custom platforms.";

const solutionsList = [
  {
    slug: "whatsapp-business-automation",
    title: "WhatsApp Business Automation",
    badge: "High Growth",
    category: "AI & Engagement",
    description:
      "Deploy official Meta WhatsApp Cloud API agents that qualify leads, process orders, issue quotes, and handle 80% of customer support in Arabic and English around the clock.",
    tags: [
      "Meta Cloud API",
      "Bilingual Arabic/English",
      "CRM Sync",
      "Lead Bot",
    ],
    icon: MessageSquareText,
  },
  {
    slug: "ai-chatbots",
    title: "AI Chatbots",
    badge: "24/7 Support",
    category: "AI & Engagement",
    description:
      "Intelligent bilingual conversational AI trained on internal SOPs, product catalogs, and databases to automate customer inquiries and ticket resolution around the clock.",
    tags: [
      "Bilingual NLP",
      "Zendesk & Freshdesk",
      "Omnichannel",
      "Zero Hallucination",
    ],
    icon: Bot,
  },
  {
    slug: "generative-ai-rag-systems",
    title: "Generative AI & RAG",
    badge: "Enterprise RAG",
    category: "Enterprise AI",
    description:
      "Enterprise retrieval-augmented generation systems allowing legal, finance, and operations teams to query millions of private documents with verifiable source citations.",
    tags: [
      "Private LLMs",
      "Vector DBs",
      "Source Citations",
      "UAE Data Privacy",
    ],
    icon: Cpu,
  },
  {
    slug: "ai-agents-automation",
    title: "AI Agents & Automation",
    badge: "Agentic Ops",
    category: "Enterprise AI",
    description:
      "Self-governing AI agent swarms that reason across enterprise software, execute multi-step business logic, and handle complex repetitive operations without human latency.",
    tags: [
      "Multi-Agent Swarms",
      "LangGraph",
      "ERP Orchestration",
      "Zero Latency",
    ],
    icon: Workflow,
  },
  {
    slug: "web-development",
    title: "Web Development",
    badge: "Enterprise Web",
    category: "Engineering",
    description:
      "High-speed custom web applications, enterprise client portals, and cloud-native digital platforms engineered in Dubai, UAE with Next.js, React, Node.js, and 100% IP ownership.",
    tags: [
      "Next.js & React",
      "Enterprise Portals",
      "Arabic RTL / English",
      "UAE Data Residency",
    ],
    icon: CodeXml,
  },
  {
    slug: "saas-product-development",
    title: "SaaS Product Development",
    badge: "Multi-Tenant SaaS",
    category: "Engineering",
    description:
      "Scalable multi-tenant B2B SaaS platforms engineered with recurring billing, Stripe/local gateways, and granular RBAC security from day one.",
    tags: ["Multi-Tenant", "Stripe Billing", "RBAC Security", "Audit Logs"],
    icon: Layers,
  },
  {
    slug: "mobile-app-development",
    title: "Mobile App Development",
    badge: "Mobile Native",
    category: "Product & Mobile",
    description:
      "Native and cross-platform mobile apps built with Flutter, React Native, Swift, and Kotlin. Sub-second performance, biometric auth, offline mode, and Apple Pay.",
    tags: [
      "iOS & Android",
      "Flutter & React Native",
      "Biometric Auth",
      "Apple Pay",
    ],
    icon: Smartphone,
  },
  {
    slug: "erp-crm-solutions",
    title: "ERP & CRM Solutions",
    badge: "Unified Ops",
    category: "Operations",
    description:
      "Tailored ERP and CRM implementations designed to centralize sales, inventory, and finance with full UAE FTA VAT and e-invoicing compliance.",
    tags: ["FTA VAT E-Invoicing", "Multi-Warehouse", "Sales CRM", "Accounting"],
    icon: Database,
  },
  {
    slug: "ecommerce-marketplace-solutions",
    title: "E-Commerce Solutions",
    badge: "Digital Retail",
    category: "Digital Retail",
    description:
      "High-converting e-commerce stores engineered on Shopify, WooCommerce, and bespoke custom headless platforms.",
    tags: ["Shopify", "WooCommerce", "Custom Stores", "Apple Pay & Tabby"],
    icon: ShoppingBag,
  },
  {
    slug: "ui-ux-design",
    title: "UI/UX Design",
    badge: "Product Design",
    category: "Experience",
    description:
      "User-centric product design for complex enterprise software, SaaS dashboards, and customer apps. Bilingual English/Arabic design systems built in Figma.",
    tags: ["Figma Systems", "Bilingual UX", "B2B Dashboards", "Prototypes"],
    icon: Layers,
  },
  {
    slug: "interactive-prototyping",
    title: "Interactive Prototyping",
    badge: "Rapid Validation",
    category: "Product Lab",
    description:
      "High-fidelity clickable Figma prototypes and user testing sprints that de-risk software engineering before writing a single line of production code.",
    tags: [
      "Figma Prototypes",
      "User Testing",
      "Investor Demos",
      "Design Tokens",
    ],
    icon: Compass,
  },
  {
    slug: "cloud-architecture-migration",
    title: "Cloud Architecture & Migration",
    badge: "Cloud Migration",
    category: "Cloud",
    description:
      "Lift-and-shift and replatforming legacy workloads to AWS, Azure, and UAE sovereign cloud data centers with zero data loss and automated rollbacks.",
    tags: ["AWS & Azure", "UAE Cloud", "Zero Downtime", "Cost Optimization"],
    icon: Cloud,
  },
  {
    slug: "cicd-delivery-pipelines",
    title: "CI/CD & Delivery Pipelines",
    badge: "DevOps Velocity",
    category: "Cloud",
    description:
      "Automated test suites, security vulnerability scans, and continuous delivery pipelines that turn releases into routine, zero-downtime events.",
    tags: [
      "GitHub Actions",
      "GitLab CI",
      "Automated QA",
      "Zero-Downtime Deploys",
    ],
    icon: GitBranch,
  },
  {
    slug: "infrastructure-as-code",
    title: "Infrastructure as Code",
    badge: "Declarative Cloud",
    category: "Cloud",
    description:
      "Automate and audit cloud environments using Terraform and OpenTofu to eliminate configuration drift and speed provisioning across environments.",
    tags: ["Terraform", "OpenTofu", "Drift Detection", "Multi-Region"],
    icon: Server,
  },
  {
    slug: "system-reliability-security",
    title: "System Reliability & Security",
    badge: "SRE & Hardening",
    category: "Security & Ops",
    description:
      "24/7 APM observability, distributed tracing, WAF configuration, and zero-trust security hardening protecting peak GCC commercial traffic.",
    tags: [
      "Datadog & Grafana",
      "WAF & DDoS",
      "24/7 On-Call",
      "UAE Law 45 Compliant",
    ],
    icon: ShieldCheck,
  },
];

const solutionsFaq = [
  {
    question:
      "What is the difference between Services and Solutions at Desert Whales Technologies?",
    answer:
      "Services represent our core technical engineering disciplines (such as Custom Software Development, Cloud Architecture, and AI Engineering). Solutions represent purpose-built, outcome-oriented implementations designed to solve specific operational challenges—such as WhatsApp Business Automation, Spreadsheet-to-CRM conversion, or UAE E-Invoicing ERP compliance.",
  },
  {
    question: "How long does a custom solution deployment take?",
    answer:
      "Focused automation modules (such as WhatsApp Lead Qualification or CRM integrations) are typically delivered in 2 to 4 weeks. Full custom software builds or enterprise ERP migrations are phased across 8 to 16 weeks with continuous working milestones.",
  },
  {
    question:
      "Does Desert Whales Technologies support UAE E-Invoicing compliance?",
    answer:
      "Yes. We integrate enterprise billing, custom ERPs, and accounting systems with the UAE Ministry of Finance e-invoicing framework (PINT AE standard) via accredited service providers to ensure seamless, compliant transmission.",
  },
  {
    question:
      "Who owns the intellectual property and source code of the solutions?",
    answer:
      "100% of the custom source code, documentation, architecture blueprints, and design assets belong entirely to your company from day one. We never lock clients into proprietary software licenses.",
  },
];

const solutionsPageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Desert Whales Technologies Enterprise Solutions",
    url: `${siteUrl}/solutions`,
    description: pageDescription,
    provider: {
      "@type": ["Organization", "ProfessionalService", "LocalBusiness"],
      name: companyIdentity.name,
      url: siteUrl,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Bay Square, Business Bay",
        addressLocality: "Dubai",
        addressRegion: "Dubai",
        addressCountry: "AE",
      },
    },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: solutionsList.map((sol, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: sol.title,
        url: `${siteUrl}/solutions/${sol.slug}`,
        description: sol.description,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: solutionsFaq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={solutionsPageSchema}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Solutions", item: "/solutions" },
  ]}
>
  <main class="bg-night text-white overflow-hidden">
    {/* ── 1. Hero Section ── */}
    <section
      class="relative min-h-[620px] overflow-hidden pt-[190px] pb-[100px] max-[620px]:min-h-0 max-[620px]:pt-[150px] max-[620px]:pb-[70px]"
    >
      {/* Banner image under the 90% black banner */}
      <div class="absolute inset-0 z-0">
        <img
          src="/banners/solutions-banner.webp"
          alt=""
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>

      {/* Solid black banner area with 90% opacity (no gradients) */}
      <div
        class="absolute inset-0 z-[1] bg-black/90 pointer-events-none"
        aria-hidden="true"
      >
      </div>

      <div class={`${shell} relative z-[2]`}>
        <nav
          aria-label="Breadcrumb"
          class="mb-8 flex items-center gap-2 text-xs text-[#a19bad]"
        >
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="opacity-40">/</span>
          <span class="text-orchid font-medium">Solutions</span>
        </nav>

        <p class={sectionLabel}>Dubai Headquarters · GCC Enterprise Delivery</p>

        <h1
          class="mb-8 max-w-[1100px] text-[clamp(3.7rem,5vw,6rem)] leading-[0.98] tracking-tight"
        >
          Intelligent solutions built for <span class="text-orchid"
            >operational impact.</span
          >
        </h1>

        <p
          class="max-w-[820px] text-[clamp(1.05rem,1.4vw,1.25rem)] leading-[1.65] text-[#cfcad8] mb-10"
        >
          Purpose-built business platforms, WhatsApp conversational automation,
          custom ERP/CRM, and autonomous AI knowledge systems engineered to
          eliminate friction and scale enterprise workflows in Dubai, UAE and
          across the GCC.
        </p>

        <div
          class="flex flex-wrap items-center gap-5 mb-14 max-[620px]:flex-col max-[620px]:items-stretch"
        >
          <a class="btn" href="#solutions-directory">
            <span>Explore Solutions</span>
            <ArrowRight className="size-4" />
          </a>
          <a class="btn-secondary" href="/contact">
            <span>Schedule Architecture Review</span>
            <ArrowUpRight className="size-4" />
          </a>
        </div>

        {/* Quick Numbers Bar */}
        <div
          class="grid grid-cols-2 gap-4 border-t border-white/10 pt-10 sm:grid-cols-4 max-[620px]:gap-6"
        >
          <div>
            <div
              class="text-3xl font-bold tracking-tight text-white lg:text-4xl"
            >
              100%
            </div>
            <div class="mt-1 text-xs text-[#a19bad]">
              Source code & IP ownership
            </div>
          </div>
          <div>
            <div
              class="text-3xl font-bold tracking-tight text-white lg:text-4xl"
            >
              Official
            </div>
            <div class="mt-1 text-xs text-[#a19bad]">
              Meta WhatsApp API partner
            </div>
          </div>
          <div>
            <div
              class="text-3xl font-bold tracking-tight text-white lg:text-4xl"
            >
              Sovereign
            </div>
            <div class="mt-1 text-xs text-[#a19bad]">
              UAE data residency ready
            </div>
          </div>
          <div>
            <div
              class="text-3xl font-bold tracking-tight text-white lg:text-4xl"
            >
              &lt; 4 wks
            </div>
            <div class="mt-1 text-xs text-[#a19bad]">
              Working solution prototype
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── 2. Solutions Directory Grid (bg-mist text-ink) ── */}
    <section id="solutions-directory" class={`${section} bg-mist text-ink`}>
      <div class={shell}>
        <div class="mb-14">
          <p class={sectionLabel}>Operational Capabilities</p>
          <h2
            class="text-[clamp(2.5rem,5vw,4.5rem)] leading-tight tracking-tight max-w-[900px]"
          >
            Targeted solutions engineered around how your company operates.
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            solutionsList.map((sol) => {
              const Icon = sol.icon;
              return (
                <div class="group relative flex flex-col justify-between rounded-3xl bg-white border border-black/8 p-8 transition-all duration-300 hover:shadow-xl hover:border-orchid/40">
                  <div>
                    <div class="flex items-center justify-between mb-6">
                      <div class="size-12 rounded-2xl bg-[#f4effc] text-[#311959] grid place-items-center">
                        <Icon className="size-6 text-[#311959]" />
                      </div>
                      <span class="inline-block px-3 py-1 rounded-full text-[11px] font-mono uppercase tracking-wider font-semibold text-[#311959] bg-[#f4effc] border border-[#311959]/15">
                        {sol.badge}
                      </span>
                    </div>

                    <h3 class="text-xl font-bold text-ink mb-3 group-hover:text-[#311959] transition-colors font-manrope">
                      {sol.title}
                    </h3>

                    <p class="text-sm text-[#5e5868] leading-relaxed mb-6">
                      {sol.description}
                    </p>

                    <div class="flex flex-wrap gap-1.5 mb-8">
                      {sol.tags.map((tag) => (
                        <span class="px-2.5 py-1 rounded-md text-[11px] font-mono text-[#4b4556] bg-black/[0.04]">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>

                  <a
                    href={`/solutions/${sol.slug}`}
                    class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider font-mono text-[#311959] group-hover:text-orchid transition-colors"
                  >
                    <span>Explore Solution Architecture</span>
                    <ArrowUpRight className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </a>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    {/* ── 3. Regional Compliance Section ── */}
    <section class={`${section} bg-white text-ink border-t border-black/8`}>
      <div class={shell}>
        <div
          class="grid grid-cols-1 lg:grid-cols-[1.2fr_.8fr] gap-12 items-center"
        >
          <div>
            <p class={sectionLabel}>UAE Compliance & Integration</p>
            <h2
              class="text-[clamp(2.5rem,4.5vw,4.2rem)] leading-tight tracking-tight mb-6"
            >
              Built for UAE, GCC, and Sovereign Data Standards.
            </h2>
            <p class="text-base text-[#5d5867] leading-relaxed mb-6">
              Operating in Dubai requires software that honors regional
              regulatory frameworks. Desert Whales Technologies integrates UAE
              Federal Decree-Law No. 45 compliance, Ministry of Finance
              e-invoicing protocols, Tabby & Apple Pay gateways, and sovereign
              UAE cloud infrastructure directly into our solution architectures.
            </p>
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <CheckCircle2 className="size-5 text-[#311959]" />
                <span class="text-sm font-medium text-ink"
                  >UAE FTA VAT & E-Invoicing (PINT AE Standard) Ready</span
                >
              </div>
              <div class="flex items-center gap-3">
                <CheckCircle2 className="size-5 text-[#311959]" />
                <span class="text-sm font-medium text-ink"
                  >UAE Personal Data Protection Law (Federal Decree-Law No. 45)
                  Compliance</span
                >
              </div>
              <div class="flex items-center gap-3">
                <CheckCircle2 className="size-5 text-[#311959]" />
                <span class="text-sm font-medium text-ink"
                  >Bilingual Arabic & English Natural Language Processing</span
                >
              </div>
              <div class="flex items-center gap-3">
                <CheckCircle2 className="size-5 text-[#311959]" />
                <span class="text-sm font-medium text-ink"
                  >Official Meta WhatsApp Cloud API Enterprise Infrastructure</span
                >
              </div>
            </div>
          </div>

          <div
            class="rounded-3xl bg-[#0d0c15] p-8 text-white border border-white/10 shadow-2xl"
          >
            <ShieldCheck className="size-10 text-orchid mb-4" />
            <h3 class="text-2xl font-bold mb-2">Need a Custom Scope?</h3>
            <p class="text-xs text-[#cfcad8] leading-relaxed mb-6">
              Share your business model, manual spreadsheets, or existing
              software stack. Our Dubai engineering leadership will prepare an
              architecture blueprint and written scope.
            </p>
            <a
              href="/contact"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-orchid px-5 py-3 text-sm font-semibold text-white hover:bg-orchid/90 transition-all cursor-pointer shadow-lg"
            >
              <span>Request Free Scope Review</span>
              <ArrowUpRight className="size-4" />
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ── 4. AEO FAQ Section ── */}
    <section class={`${section} bg-mist text-ink border-t border-black/8`}>
      <div class={shell}>
        <div class="max-w-[850px] mx-auto">
          <p class={`${sectionLabel} text-center`}>Clarifications</p>
          <h2
            class="text-[clamp(2.2rem,4vw,3.5rem)] text-center leading-tight tracking-tight mb-12"
          >
            Frequently Asked Questions
          </h2>

          <div class="space-y-4">
            {
              solutionsFaq.map((faq) => (
                <div class="rounded-2xl bg-white border border-black/8 p-6 sm:p-8">
                  <h3 class="text-lg font-bold text-ink mb-3 font-manrope">
                    {faq.question}
                  </h3>
                  <p class="text-sm text-[#5e5868] leading-relaxed">
                    {faq.answer}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
