---
import Layout from "../../layouts/Layout.astro";
import ServicesContent from "../../components/services/services-slug-content";
import { companyIdentity, siteUrl, contacts } from "@/lib/site-data";
import { getServiceDetailData, servicesDetailMap } from "@/lib/services-detail-data";

export const distinctSolutionSlugs = [
  "whatsapp-business-automation",
  "ai-chatbots",
  "generative-ai-rag-systems",
  "ai-agents-automation",
  "web-development",
  "saas-product-development",
  "mobile-app-development",
  "erp-crm-solutions",
  "ecommerce-marketplace-solutions",
  "ui-ux-design",
  "interactive-prototyping",
  "cloud-architecture-migration",
  "cicd-delivery-pipelines",
  "infrastructure-as-code",
  "system-reliability-security",
] as const;

export function getStaticPaths() {
  return distinctSolutionSlugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const fallbackTitle = "Enterprise Solution";
const fallbackDescription = "Turnkey enterprise business solution engineered by Desert Whales Technologies.";
const detail = getServiceDetailData(
  slug || "",
  fallbackTitle,
  fallbackDescription
);

const pageTitle = detail.metaTitle;
const pageDescription = detail.metaDescription;

// Specific Solution Schema for AEO & Google Rich Results
const solutionSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${siteUrl}/solutions/${slug}`,
    name: detail.heroH1 || detail.metaTitle,
    serviceType: detail.badge || fallbackTitle,
    description: pageDescription,
    url: `${siteUrl}/solutions/${slug}`,
    provider: {
      "@type": ["Organization", "ProfessionalService", "LocalBusiness"],
      name: companyIdentity.name,
      url: siteUrl,
      telephone: "+971528678679",
      email: contacts.email,
      address: {
        "@type": "PostalAddress",
        streetAddress: "Bay Square, Business Bay",
        addressLocality: "Dubai",
        addressRegion: "Dubai",
        addressCountry: "AE",
      },
    },
    areaServed: [
      { "@type": "Country", name: "United Arab Emirates" },
      { "@type": "Country", name: "Saudi Arabia" },
      { "@type": "Country", name: "Qatar" },
      { "@type": "Country", name: "Kuwait" },
      { "@type": "Country", name: "Bahrain" },
      { "@type": "Country", name: "Oman" },
      { "@type": "Place", name: "Worldwide" },
    ],
  },
  ...(detail.faqs && detail.faqs.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: detail.faqs.map((f) => ({
            "@type": "Question",
            name: f.question,
            acceptedAnswer: {
              "@type": "Answer",
              text: f.answer,
            },
          })),
        },
      ]
    : []),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={solutionSchema}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Solutions", item: "/solutions" },
    { name: detail.badge || fallbackTitle, item: `/solutions/${slug}` },
  ]}
>
  <ServicesContent
    client:load
    params={{ slug: slug || "" }}
    initialDetail={detail}
  />
</Layout>
