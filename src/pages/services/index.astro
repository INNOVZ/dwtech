---
import Layout from "../../layouts/Layout.astro";
import {
  services,
  serviceCategories,
  companyIdentity,
  siteUrl,
} from "@/lib/site-data";
import { section, sectionLabel, shell } from "@/lib/styles";
import { ArrowUpRight, ArrowRight } from "@/components/layout/icons";

const pageTitle = "Enterprise Technology & AI Services Dubai, UAE | Desert Whales Technologies";
const pageDescription =
  "Explore Desert Whales Technologies specialized services in Dubai, UAE: custom software development, enterprise AI automation, ERP & CRM solutions, cloud architecture, and mobile engineering for UAE and global enterprises.";

// AEO FAQ for Services
const servicesFaq = [
  {
    question: "What core technology services does Desert Whales Technologies provide?",
    answer:
      "Desert Whales Technologies provides 10 core technology disciplines including Custom Software Development, AI & Automation Solutions, ERP & CRM Integration, Cloud & DevOps, Mobile App Development, UI/UX Design, and Digital Transformation Strategy.",
  },
  {
    question:
      "Does Desert Whales Technologies serve businesses in Dubai, UAE, and the wider GCC region?",
    answer:
      "Yes, Desert Whales Technologies is headquartered in Dubai, UAE, and engineers solutions across the UAE, Saudi Arabia (Riyadh), India, and Europe, adhering to regional regulations including UAE FTA VAT and local data residency standards.",
  },
  {
    question:
      "How does Desert Whales Technologies approach custom software and enterprise AI projects?",
    answer:
      "We employ a composable, agile methodology starting with thorough business discovery, solution architecture, rapid prototyping, and scalable full-stack implementation with ongoing optimization.",
  },
  {
    question:
      "Who owns the intellectual property and source code upon completion?",
    answer:
      "100% of the custom source code, documentation, architecture blueprints, and design assets belong entirely to your company.",
  },
];

// Schema for Services Directory (CollectionPage + ItemList + FAQPage)
const servicesPageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Desert Whales Technologies Enterprise Services",
    url: `${siteUrl}/services`,
    description: pageDescription,
    provider: {
      "@type": "ProfessionalService",
      name: companyIdentity.name,
      url: siteUrl,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Dubai",
        addressCountry: "AE",
      },
    },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: services.map((service, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: service.title,
        url: `${siteUrl}/services/${service.slug}`,
        description: service.description,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: servicesFaq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={servicesPageSchema}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Services", item: "/services" },
  ]}
>
  <main class="bg-night text-white overflow-hidden">
    {/* ── 1. Hero Section (Matches About & Portfolio UI/UX) ── */}
    <section
      class="relative min-h-[650px] bg-[radial-gradient(circle_at_78%_35%,rgba(176,99,255,.22),transparent_34%),#05040e] pt-[190px] pb-[100px] max-[620px]:min-h-0 max-[620px]:pt-[150px] max-[620px]:pb-[70px]"
    >
      {/* Subtle Dot Matrix matching Portfolio */}
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(176,99,255,.3)_0_1px,transparent_1.3px)] bg-[length:64px_64px] opacity-15"
        aria-hidden="true"
      >
      </div>

      <div class={`${shell} relative z-[1]`}>
        {/* Breadcrumb nav */}
        <nav
          aria-label="Breadcrumb"
          class="mb-8 flex items-center gap-2 text-xs text-[#a19bad]"
        >
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span class="opacity-40">/</span>
          <span class="text-orchid">Services</span>
        </nav>

        <p class={sectionLabel}>Dubai Headquarters · Global Delivery</p>

        <h1
          class="mb-8 max-w-[1100px] text-[clamp(3.2rem,6.8vw,5.8rem)] leading-[0.98] tracking-tight"
        >
          Technology shaped for <span class="text-orchid">tangible outcomes.</span>
        </h1>

        <p
          class="max-w-[820px] text-[clamp(1.05rem,1.4vw,1.25rem)] leading-[1.65] text-[#cfcad8] mb-10"
        >
          From custom cloud software and intelligent workflow automation to
          unified ERP ecosystems and intuitive mobile applications, Desert Whales Technologies
          partners with ambitious enterprises to modernize operations and
          accelerate growth across Dubai, UAE, the Middle East, and worldwide.
        </p>

        <div
          class="flex flex-wrap items-center gap-5 mb-14 max-[620px]:flex-col max-[620px]:items-stretch"
        >
          <a
            class="btn"
            href="/contact"
          >
            Make an Enquiry <ArrowUpRight />
          </a>
        </div>

        {/* Aggregate Impact Numbers (Matches Portfolio layout) */}
        <div
          class="grid grid-cols-4 gap-6 border-t border-white/15 pt-8 max-[900px]:grid-cols-2 max-[500px]:grid-cols-1"
        >
          <div>
            <span class="text-2xl lg:text-3xl font-bold text-white">10</span>
            <p class="mt-1 text-xs text-[#9d97a9] leading-relaxed">
              Specialized Engineering Disciplines
            </p>
          </div>
          <div>
            <span class="text-2xl lg:text-3xl font-bold text-white">100%</span>
            <p class="mt-1 text-xs text-[#9d97a9] leading-relaxed">
              UAE & GCC Regulatory Compliance
            </p>
          </div>
          <div>
            <span class="text-2xl lg:text-3xl font-bold text-white">&lt; 4 wks</span>
            <p class="mt-1 text-xs text-[#9d97a9] leading-relaxed">
              Rapid Proof-of-Concept Turnaround
            </p>
          </div>
          <div>
            <span class="text-2xl lg:text-3xl font-bold text-white">4 Hubs</span>
            <p class="mt-1 text-xs text-[#9d97a9] leading-relaxed">
              Dubai · Riyadh · Milan · Kerala
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── 2. Practices Directory (Matches About Section 2: bg-mist text-ink) ── */}
    <section class={`${section} bg-mist text-ink`} id="catalog">
      <div class={shell}>
        <div class="mb-14 max-w-[920px]">
          <p class={sectionLabel}>Core Disciplines</p>
          <h2 class="text-[clamp(2.8rem,4.8vw,5.2rem)] leading-tight">
            Strategy, engineering, and execution across four practices.
          </h2>
          <p class="text-base text-[#5d5867] mt-4 leading-relaxed max-w-[700px]">
            Every practice is led by seasoned software engineers, AI
            researchers, and solutions architects committed to dependable,
            scalable execution.
          </p>
        </div>

        <div class="space-y-16">
          {
            serviceCategories.map((category, catIndex) => {
              const categoryServices = services.filter((s) =>
                (category.slugs as readonly string[]).includes(s.slug)
              );

              return (
                <div class="border-t border-black/15 pt-10">
                  <div class="flex items-start justify-between gap-6 pb-6 mb-8 max-[700px]:flex-col">
                    <div>
                      <span class="text-xs font-semibold text-orchid uppercase tracking-widest">
                        Practice 0{catIndex + 1}
                      </span>
                      <h3 class="text-2xl lg:text-3xl font-semibold text-ink mt-1 m-0">
                        {category.title}
                      </h3>
                    </div>
                    <p class="text-sm text-[#5d5867] max-w-[460px] m-0 leading-relaxed">
                      {category.description}
                    </p>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {categoryServices.map((service) => (
                      <a
                        href={`/services/${service.slug}`}
                        class="group rounded-3xl bg-white p-7 border border-black/5 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
                      >
                        <div>
                          <div class="flex items-center justify-between mb-4">
                            <span class="inline-flex items-center rounded-full bg-orchid/10 px-2.5 py-1 text-xs font-semibold text-orchid">
                              {service.category}
                            </span>
                            <span class="size-7 rounded-full bg-black/5 grid place-items-center text-black/60 transition-transform duration-300 group-hover:bg-orchid group-hover:text-white group-hover:rotate-45">
                              <ArrowUpRight />
                            </span>
                          </div>
                          <h4 class="text-xl font-semibold text-ink group-hover:text-orchid transition-colors mb-2.5">
                            {service.title}
                          </h4>
                          <p class="text-sm leading-relaxed text-[#5d5867] mb-6">
                            {service.short}
                          </p>
                        </div>

                        <div>
                          <div class="border-t border-black/10 pt-4">
                            <p class="text-[.72rem] uppercase tracking-wider font-semibold text-[#8e879a] mb-2">
                              Key Deliverables
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                              {service.deliverables.slice(0, 3).map((item) => (
                                <span class="rounded bg-black/[0.04] px-2 py-0.5 text-xs text-[#524d5c]">
                                  {item}
                                </span>
                              ))}
                            </div>
                          </div>

                          <div class="mt-5 flex items-center gap-1.5 text-xs font-semibold text-orchid">
                            <span>View discipline details</span>
                            <ArrowRight className="size-3.5 transition-transform duration-200 group-hover:translate-x-1" />
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    {/* ── 3. Regional Governance & Standards (Matches About Section 3: bg-white text-ink) ── */}
    <section class={`${section} bg-white text-ink`}>
      <div class={shell}>
        <div class="grid grid-cols-[.8fr_1.2fr] gap-[8vw] max-[860px]:grid-cols-1">
          <div>
            <p class={sectionLabel}>Regional Standards</p>
            <h2 class="text-[clamp(2.8rem,4.8vw,5.2rem)] leading-tight">
              Engineered for UAE, GCC, and International Standards.
            </h2>
            <p class="text-base text-[#5d5867] mt-6 leading-relaxed">
              Modern enterprises operating across Dubai, Abu Dhabi, Riyadh, India,
              and Milan require digital architectures that unite speed with
              stringent regulatory adherence. Desert Whales Technologies integrates local tax
              workflows, multilingual natural language models, and sovereign
              cloud infrastructure directly into our delivery.
            </p>
          </div>

          <dl class="divide-y divide-black/15">
            <div class="py-6 first:pt-0">
              <dt class="text-[1.25rem] font-semibold text-ink">
                UAE FTA Tax & VAT Automation
              </dt>
              <dd class="mt-2 text-[#5d5867] text-base leading-relaxed">
                Seamless integration with UAE Federal Tax Authority rules and
                electronic invoicing standards.
              </dd>
            </div>
            <div class="py-6">
              <dt class="text-[1.25rem] font-semibold text-ink">
                Sovereign Data Protection
              </dt>
              <dd class="mt-2 text-[#5d5867] text-base leading-relaxed">
                In-region sovereign data residency adhering to UAE Federal
                Decree-Law No. 45 and Saudi NDMO data regulations.
              </dd>
            </div>
            <div class="py-6">
              <dt class="text-[1.25rem] font-semibold text-ink">
                Bilingual Arabic & English Architecture
              </dt>
              <dd class="mt-2 text-[#5d5867] text-base leading-relaxed">
                First-class bidirectional (RTL) interfaces and multilingual AI
                models tuned for Gulf dialects.
              </dd>
            </div>
            <div class="py-6">
              <dt class="text-[1.25rem] font-semibold text-ink">
                100% Intellectual Property Ownership
              </dt>
              <dd class="mt-2 text-[#5d5867] text-base leading-relaxed">
                Complete handover of custom source code, documentation,
                architecture blueprints, and design assets.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    {/* ── 4. Frequently Asked Questions (Matches About & Homepage FAQ: bg-mist text-ink) ── */}
    <section class={`${section} bg-mist text-ink`}>
      <div class={shell}>
        <div
          class="grid grid-cols-[.7fr_1.3fr] gap-[8vw] max-[860px]:grid-cols-1"
        >
          <div>
            <p class={sectionLabel}>Clear Answers</p>
            <h2 class="text-[clamp(2.8rem,4.8vw,5.2rem)] leading-tight">
              Frequently asked questions.
            </h2>
            <p class="text-base text-[#5d5867] mt-4 leading-relaxed">
              Common queries regarding our technology disciplines, delivery
              timelines, and enterprise engagement.
            </p>
          </div>

          <div class="divide-y divide-black/15">
            {
              servicesFaq.map((faq) => (
                <div class="py-6 first:pt-0">
                  <h3 class="text-lg lg:text-xl font-semibold text-ink mb-2">
                    {faq.question}
                  </h3>
                  <p class="text-base leading-relaxed text-[#5d5867] m-0">
                    {faq.answer}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* ── 5. Closing Consultation CTA (Matches DW Tech Minimal Design) ── */}
    <section
      class="relative py-28 bg-[radial-gradient(circle_at_78%_0,rgba(176,99,255,.18),transparent_34%),#05040e] text-center border-t border-white/10"
    >
      <div class={`${shell} max-w-[820px]`}>
        <p class={sectionLabel}>Get Started</p>
        <h2
          class="text-[clamp(3rem,5.5vw,5.6rem)] text-white tracking-tight mb-6 leading-tight"
        >
          Ready to engineer your <span class="text-orchid">advantage?</span>
        </h2>
        <p class="text-base lg:text-lg text-[#bfb9ca] mb-10 leading-relaxed max-w-[620px] mx-auto">
          Book an architectural discovery consultation with our technical
          leadership in Dubai to evaluate your software and automation opportunities.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a
            class="btn text-base font-semibold"
            href="/contact"
          >
            Make an Enquiry <ArrowUpRight />
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
