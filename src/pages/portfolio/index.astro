---
import Layout from "../../layouts/Layout.astro";
import { portfolioProjects, companyIdentity, siteUrl } from "@/lib/site-data";
import { section, sectionLabel, shell } from "@/lib/styles";
import PortfolioInteractiveFlow from "@/components/portfolio-interactive-flow";

const pageTitle = "Portfolio & Case Studies | DW Tech Dubai";
const pageDescription =
  "Explore DW Tech's case studies: enterprise ERP, generative AI patient triage, headless e-commerce, wealth management dashboards, and commercial real estate mobile apps across Dubai, UAE, Saudi Arabia, and Europe.";

const portfolioSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "DW Tech Engineering Portfolio & Case Studies",
  url: `${siteUrl}/portfolio`,
  description: pageDescription,
  provider: {
    "@type": "ProfessionalService",
    name: companyIdentity.name,
    url: siteUrl,
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: portfolioProjects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "CreativeWork",
        name: project.title,
        description: project.summary,
        locationCreated: project.location,
        keywords: project.tags.join(", "),
      },
    })),
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={portfolioSchema}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Portfolio", item: "/portfolio" },
  ]}
>
  <main class="bg-night text-white">
    {/* ── Hero Section ── */}
    <section
      class="relative pt-[160px] pb-[90px] bg-[radial-gradient(ellipse_at_80%_20%,rgba(176,99,255,0.22),transparent_50%),#05040e]"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,rgba(176,99,255,.3)_0_1px,transparent_1.3px)] bg-[length:64px_64px] opacity-15"
      >
      </div>

      <div class={`${shell} relative z-1`}>
        <h1
          class="text-[clamp(3.7rem,5vw,6rem)] leading-[0.98] tracking-tight max-w-[1100px] mb-8"
        >
          Proof through <span class="text-orchid">performance.</span>
        </h1>

        <p
          class="max-w-[820px] text-[clamp(1.05rem,1.4vw,1rem)] leading-[1.65] text-[#cfcad8] mb-10"
        >
          We engineer robust digital platforms, intelligent workflows, and
          custom software systems designed to solve concrete operational
          challenges. Here is a curated selection of our work across logistics,
          healthcare, financial services, commerce, and real estate.
        </p>

        {/* Aggregate Impact Numbers */}
        <div
          class="grid grid-cols-4 gap-4 border-t border-white/15 pt-8 max-[900px]:grid-cols-2 max-[500px]:grid-cols-1"
        >
          <div class="">
            <span class="text-2xl lg:text-3xl font-bold text-white">50+</span>
            <p class="mt-1 text-xs text-[#9d97a9]">Project Delivered</p>
          </div>
          <div class="">
            <span class="text-2xl lg:text-3xl font-bold text-white">30+</span>
            <p class="mt-1 text-xs text-[#9d97a9]">Clients</p>
          </div>
          <div class="">
            <span class="text-2xl lg:text-3xl font-bold text-white"
              >Covered 8+</span
            >
            <p class="mt-1 text-xs text-[#9d97a9]">Industries</p>
          </div>
          <div class="">
            <span class="text-2xl lg:text-3xl font-bold text-white"
              >Across 4</span
            >
            <p class="mt-1 text-xs text-[#9d97a9]">Countries</p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Case Studies List: Interactive Stacking Cards Section ── */}
    <section
      class={`${section} relative bg-[#faf9fd] text-[#05040e] border-t border-black/5`}
      id="case-studies"
    >
      <div class={shell}>
        <div class="mb-14 lg:mb-16 text-center max-w-[820px] mx-auto">
          <h2
            class="text-[clamp(2.5rem,4.5vw,4.5rem)] text-[#05040e] tracking-tight"
          >
            Case studies & Client deployments
          </h2>
          <p class="mt-4 text-base lg:text-lg text-[#615a6e] leading-relaxed">
            Explore our engineering deployments across the UAE and global
            markets — scroll down to see the cards stack over each other with
            turnkey architectures, verified ROI, and technical deliverables.
          </p>
        </div>

        <PortfolioInteractiveFlow client:load />
      </div>
    </section>
  </main>
</Layout>
