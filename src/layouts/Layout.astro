---
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { companyIdentity, siteAuthor, siteUrl } from "@/lib/site-data";

interface Props {
  title?: string;
  description?: string;
  author?: string;
  canonical?: string;
  ogType?: "website" | "article" | "profile";
  ogImage?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  breadcrumbs?: Array<{ name: string; item: string }>;
  headerTheme?: "dark" | "light";
}

const defaultTitle =
  "Custom Software & Enterprise AI Dubai | Desert Whales Tech";
const defaultDescription =
  "Desert Whales Technologies is a premier Dubai technology partner engineering custom software, enterprise AI automation, ERP/CRM solutions, cloud architecture, and mobile apps.";
const defaultAuthor = siteAuthor;

const {
  title = defaultTitle,
  description = defaultDescription,
  author = defaultAuthor,
  canonical,
  ogType = "website",
  ogImage = `${siteUrl}/hero-whale.png`,
  schema,
  breadcrumbs,
  headerTheme = "dark",
} = Astro.props;

const normalizeUrl = (urlStr: string) => {
  try {
    const u = new URL(urlStr);
    if (u.pathname.length > 1 && u.pathname.endsWith("/")) {
      u.pathname = u.pathname.replace(/\/+$/, "");
    }
    return u.toString();
  } catch {
    return urlStr;
  }
};

const rawCurrentUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const currentUrl = normalizeUrl(rawCurrentUrl);

// WebSite Schema for Search & AI Engines
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Desert Whales Technologies",
  url: siteUrl,
  author: {
    "@type": "Person",
    name: author,
  },
};

// Primary Site Navigation Schema for SEO, GEO, and AEO
const navigationSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  name: "Desert Whales Technologies Primary Navigation",
  hasPart: [
    {
      "@type": "SiteNavigationElement",
      name: "Services",
      url: `${siteUrl}/services`,
      description:
        "Comprehensive custom software, enterprise AI, ERP & CRM, mobile apps, and cloud engineering services.",
    },
    {
      "@type": "SiteNavigationElement",
      name: "Solutions",
      url: `${siteUrl}/solutions`,
      description:
        "Enterprise business solutions including WhatsApp automation, custom ERP/CRM, and AI knowledge workflows.",
    },
    {
      "@type": "SiteNavigationElement",
      name: "Portfolio",
      url: `${siteUrl}/portfolio`,
      description:
        "Case studies and delivered projects across logistics, healthcare, luxury e-commerce, real estate, and finance.",
    },
    {
      "@type": "SiteNavigationElement",
      name: "Blogs & Insights",
      url: `${siteUrl}/blogs`,
      description:
        "Thought leadership on GCC AI adoption, custom software architecture, and modern digital engineering.",
    },
    {
      "@type": "SiteNavigationElement",
      name: "Company",
      url: `${siteUrl}/about`,
      description:
        "About Desert Whales Technologies, leadership, operating philosophy, and global delivery centers.",
    },
    {
      "@type": "SiteNavigationElement",
      name: "Contact",
      url: `${siteUrl}/contact`,
      description:
        "Connect with Desert Whales Technologies engineering leaders for new project inquiries.",
    },
  ],
};

// Breadcrumb Schema
const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((b, idx) => ({
          "@type": "ListItem",
          position: idx + 1,
          name: b.name,
          item: normalizeUrl(b.item.startsWith("http") ? b.item : `${siteUrl}${b.item}`),
        })),
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={currentUrl} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* GEO Meta Tags for Location & Localized Engine Discovery */}
    <meta name="geo.region" content="AE-DU" />
    <meta name="geo.placename" content="Dubai" />
    <meta
      name="geo.position"
      content={`${companyIdentity.headquarters.latitude};${companyIdentity.headquarters.longitude}`}
    />
    <meta
      name="ICBM"
      content={`${companyIdentity.headquarters.latitude}, ${companyIdentity.headquarters.longitude}`}
    />

    {/* AEO / Generative Engine & Social Graph */}
    <meta property="og:site_name" content="Desert Whales Technologies" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_AE" />
    {ogType === "article" && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content={author} />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Manrope:wght@400;600;700&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    {/* Structural Navigation Schema */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(navigationSchema)}
    />
    {/* WebSite Schema with Author */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    {
      breadcrumbSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      )
    }
    {
      schema && (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    }

    <style is:global>
      :root {
        --font-lato: "Lato", sans-serif;
        --font-space-grotesk: "Space Grotesk", sans-serif;
        --font-manrope: "Manrope", sans-serif;
      }
    </style>
  </head>
  <body>
    <SiteHeader theme={headerTheme} />
    <slot />
    <SiteFooter />
  </body>
</html>
