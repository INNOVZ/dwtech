---
import { Logo } from "@/components/layout/logo";
import { ArrowUpRight, Close, Menu } from "@/components/layout/icons";
import { button, shell } from "@/lib/styles";
import {
  ChevronDown,
  ArrowRight,
  CodeXml,
  Workflow,
  Sparkle,
  Cloud,
} from "lucide-react";

// Services submenu items (4 core services) styled as a vertical dropdown list
const servicesList = [
  {
    title: "Custom software development",
    href: "/services/custom-software-development",
    icon: CodeXml,
  },
  {
    title: "AI Integrated solutions & automation",
    href: "/services/ai-automation-solutions",
    icon: Workflow,
  },
  {
    title: "Product Design and Development",
    href: "/services/product-design-development",
    icon: Sparkle,
  },
  {
    title: "Cloud and DevOps Solutions",
    href: "/services/cloud-and-devops",
    icon: Cloud,
  },
];

// All sub-menu items organized in 4 columns for Solutions (without repeating the core 4 services)
const solutionsColumns = [
  [
    {
      label: "Web Applications & Mobile Applications Development",
      href: "/solutions/custom-software-development",
    },
    {
      label: "ERP & CRM Solutions",
      href: "/solutions/erp-crm-solutions",
    },
    {
      label: "E-Commerce & Marketplaces",
      href: "/solutions/ecommerce-marketplace-solutions",
    },
    {
      label: "Digital Business Transformation",
      href: "/solutions/digital-business-transformation",
    },
  ],
  [
    {
      label: "Generative AI & custom RAG system",
      href: "/solutions/ai-automation-solutions",
    },
    {
      label: "WhatsApp Business Automation",
      href: "/solutions/whatsapp-business-automation",
    },
    {
      label: "AI agents & Automation for business",
      href: "/solutions/ai-automation-solutions",
    },
    {
      label: "AI chatbots",
      href: "/solutions/ai-automation-solutions",
    },
  ],
  [
    {
      label: "UI/UX & Design Systems",
      href: "/solutions/ui-ux-design",
    },
    {
      label: "Mobile App Development",
      href: "/solutions/mobile-app-development",
    },
    {
      label: "Interactive Prototyping",
      href: "/solutions/product-design-development",
    },
    {
      label: "SaaS Product Development",
      href: "/solutions/product-design-development",
    },
  ],
  [
    {
      label: "Cloud Architecture & Migration",
      href: "/solutions/cloud-and-devops",
    },
    {
      label: "CI/CD & Delivery Pipelines",
      href: "/solutions/cloud-and-devops",
    },
    {
      label: "Infrastructure as Code (IaC)",
      href: "/solutions/cloud-and-devops",
    },
    {
      label: "System Reliability & Security",
      href: "/solutions/cloud-and-devops",
    },
  ],
];

interface Props {
  theme?: "dark" | "light";
}

const { theme = "dark" } = Astro.props;
const isLight = theme === "light";
---

<header
  class={`absolute top-0 left-0 z-30 w-full py-[20px] ${isLight ? "text-[#311959]" : "text-white"}`}
  id="site-header"
>
  <div
    class={`${shell} relative z-[2] grid grid-cols-[auto_1fr_auto] items-center gap-6 max-[1020px]:grid-cols-[1fr_auto]`}
  >
    {/* Logo */}
    <Logo light={!isLight} />

    {/* Desktop Navigation - Centered, with Services right in the middle */}
    <nav
      class="hidden min-[1020px]:flex items-center justify-center gap-8 lg:gap-9"
      aria-label="Primary navigation"
    >
      {/* 1. Home */}
      <a
        class={`relative grid min-h-11 place-items-center text-[.88rem] transition-colors duration-200 after:absolute after:bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-orchid after:transition-transform after:duration-250 after:ease-fluid after:content-[''] hover:after:scale-x-100 ${
          isLight
            ? "text-[#311959]/80 hover:text-[#311959]"
            : "text-white/80 hover:text-white"
        }`}
        href="/"
      >
        Home
      </a>

      {/* 2. Company */}
      <a
        class={`relative grid min-h-11 place-items-center text-[.88rem] transition-colors duration-200 after:absolute after:bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-orchid after:transition-transform after:duration-250 after:ease-fluid after:content-[''] hover:after:scale-x-100 ${
          isLight
            ? "text-[#311959]/80 hover:text-[#311959]"
            : "text-white/80 hover:text-white"
        }`}
        href="/about"
      >
        About
      </a>

      {/* 3. Services (4 Core Services Dropdown) */}
      <div class="relative group" id="services-nav-container">
        <button
          type="button"
          id="services-menu-trigger"
          class={`relative flex items-center gap-1.5 py-2.5 text-[.88rem] font-medium transition-colors duration-200 focus:outline-none focus-visible:text-orchid ${
            isLight
              ? "text-[#311959]/80 hover:text-[#311959] group-hover:text-[#311959] aria-expanded:text-[#311959]"
              : "text-white/80 hover:text-white group-hover:text-white aria-expanded:text-white"
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="services-dropdown-panel"
        >
          <span>Services</span>
          <ChevronDown
            id="services-caret"
            className={`size-3.5 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180 [aria-expanded=true]:rotate-180 ${
              isLight ? "text-[#311959]/60" : "text-white/60"
            }`}
            aria-hidden="true"
          />
        </button>

        {
          /* Services Dropdown Panel (Vertical list matching reference image style) */
        }
        <div
          id="services-dropdown-panel"
          class="invisible absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 transition-all duration-250 ease-fluid group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 data-[state=open]:visible data-[state=open]:opacity-100"
          data-state="closed"
          role="region"
          aria-label="Services Submenu"
        >
          <div
            class="w-[340px] overflow-hidden rounded-[20px] border border-black/[0.08] bg-white/98 p-2.5 shadow-[0_25px_65px_-12px_rgba(0,0,0,0.35),0_0_1px_1px_rgba(0,0,0,0.06)] backdrop-blur-2xl text-ink"
          >
            <div class="flex flex-col gap-1">
              {
                servicesList.map((service) => {
                  const ServiceIcon = service.icon;
                  return (
                    <a
                      href={service.href}
                      class="group/sub flex items-center gap-3.5 rounded-xl px-3.5 py-3 text-[.92rem] font-medium text-ink transition-all duration-150 hover:bg-black/[0.05] hover:text-[#311959]"
                    >
                      <span class="grid size-5 shrink-0 place-items-center text-ink transition-colors group-hover/sub:text-[#311959]">
                        <ServiceIcon size={19} strokeWidth={2} />
                      </span>
                      <span class="whitespace-nowrap">{service.title}</span>
                    </a>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>

      {/* 4. Solutions (Full Megamenu containing all specialized submenus) */}
      <div class="relative group" id="solutions-nav-container">
        <button
          type="button"
          id="solutions-menu-trigger"
          class={`relative flex items-center gap-1.5 py-2.5 text-[.88rem] font-medium transition-colors duration-200 focus:outline-none focus-visible:text-orchid ${
            isLight
              ? "text-[#311959]/80 hover:text-[#311959] group-hover:text-[#311959] aria-expanded:text-[#311959]"
              : "text-white/80 hover:text-white group-hover:text-white aria-expanded:text-white"
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="solutions-dropdown-panel"
        >
          <span>Solutions</span>
          <ChevronDown
            id="solutions-caret"
            className={`size-3.5 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180 [aria-expanded=true]:rotate-180 ${
              isLight ? "text-[#311959]/60" : "text-white/60"
            }`}
            aria-hidden="true"
          />
        </button>

        {/* Clean, Light Mega Menu Submenu Panel for Solutions */}
        <div
          id="solutions-dropdown-panel"
          class="invisible absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 transition-all duration-250 ease-fluid group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 data-[state=open]:visible data-[state=open]:opacity-100"
          data-state="closed"
          role="region"
          aria-label="Solutions Submenu"
        >
          <div
            class="w-[min(1160px,calc(100vw-36px))] overflow-hidden rounded-[20px] border border-black/[0.08] bg-white/98 p-7 lg:p-8 shadow-[0_25px_65px_-12px_rgba(0,0,0,0.35),0_0_1px_1px_rgba(0,0,0,0.06)] backdrop-blur-2xl text-ink"
          >
            <div
              class="grid grid-cols-4 gap-6 lg:gap-8 max-[1120px]:grid-cols-2 max-[640px]:grid-cols-1"
            >
              {
                solutionsColumns.map((col) => (
                  <div class="flex flex-col gap-2">
                    {col.map((item) => (
                      <a
                        href={item.href}
                        class="group/sub flex items-start gap-3 rounded-xl px-3 py-2.5 text-[.92rem] font-medium text-ink transition-all duration-150 hover:bg-black/[0.05] hover:text-[#311959]"
                      >
                        <ArrowRight className="size-4 shrink-0 mt-0.5 text-ink transition-transform duration-200 group-hover/sub:translate-x-1 group-hover/sub:text-[#311959]" />
                        <span class="text-ink transition-colors duration-150 group-hover/sub:text-[#311959] leading-snug">
                          {item.label}
                        </span>
                      </a>
                    ))}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      {/* 4. Portfolios */}
      <a
        class={`relative grid min-h-11 place-items-center text-[.88rem] transition-colors duration-200 after:absolute after:bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-orchid after:transition-transform after:duration-250 after:ease-fluid after:content-[''] hover:after:scale-x-100 ${
          isLight
            ? "text-[#311959]/80 hover:text-[#311959]"
            : "text-white/80 hover:text-white"
        }`}
        href="/portfolio"
      >
        Case Studies
      </a>

      {/* 5. Blogs */}
      <a
        class={`relative grid min-h-11 place-items-center text-[.88rem] transition-colors duration-200 after:absolute after:bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-orchid after:transition-transform after:duration-250 after:ease-fluid after:content-[''] hover:after:scale-x-100 ${
          isLight
            ? "text-[#311959] font-semibold"
            : "text-white/80 hover:text-white"
        }`}
        href="/blogs"
      >
        Blogs
      </a>
    </nav>

    {/* Action CTA */}
    <a
      class={`hidden min-[1020px]:flex items-center p-1 gap-3 justify-self-end text-[.9rem] ${
        isLight ? "text-[#311959]" : "text-white"
      }`}
      href="/contact"
    >
      <span class="cta-link-text" data-text="Contact US">Contact Us</span>
      <span
        class={`${button} ${isLight ? "!border-[#311959] !text-[#311959]" : ""}`}
      >
        <ArrowUpRight />
      </span>
    </a>

    {/* Mobile Hamburger Toggle Button */}
    <button
      id="mobile-menu-toggle"
      class={`hidden size-11 cursor-pointer place-items-center justify-self-end rounded-lg border bg-transparent p-2.5 max-[1020px]:grid [&_svg]:size-[22px] [&_svg]:fill-none [&_svg]:stroke-current [&_svg]:stroke-[1.6] [&_svg]:[stroke-linecap:round] ${
        isLight
          ? "border-[#311959]/20 text-[#311959]"
          : "border-white/20 text-white"
      }`}
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label="Open navigation"
    >
      <div id="icon-menu"><Menu /></div>
      <div id="icon-close" class="hidden"><Close /></div>
    </button>
  </div>

  {/* Mobile Navigation Drawer */}
  <div
    id="mobile-navigation"
    class="invisible fixed inset-0 z-[1] h-svh w-full -translate-y-full overflow-y-auto bg-night pt-[88px] opacity-0 transition-[opacity,transform,visibility] duration-350 ease-fluid data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100"
    data-open="false"
  >
    <nav
      class="flex min-h-0 flex-col gap-1 px-[clamp(20px,4.2vw,72px)] pb-12 max-[620px]:px-5"
      aria-label="Mobile navigation"
    >
      {/* 1. Mobile Home */}
      <a
        class="mobile-nav-link border-b border-white/20 py-4 text-2xl font-light text-white"
        href="/"
      >
        Home
      </a>

      {/* 2. Mobile Company */}
      <a
        class="mobile-nav-link border-b border-white/20 py-4 text-2xl font-light text-white"
        href="/about"
      >
        About
      </a>

      {/* 3. Mobile Services Accordion Section (4 Core Services) */}
      <div class="border-b border-white/20 py-3" id="mobile-services-accordion">
        <button
          type="button"
          id="mobile-services-toggle"
          class="flex w-full items-center justify-between py-2 text-2xl font-light text-white text-left focus:outline-none"
          aria-expanded="false"
          aria-controls="mobile-services-submenu"
        >
          <span>Services</span>
          <ChevronDown
            id="mobile-services-caret"
            className="size-5 text-orchid transition-transform duration-300"
            aria-hidden="true"
          />
        </button>
        <div
          id="mobile-services-submenu"
          class="hidden pt-3 pb-2 transition-all duration-300"
        >
          <a
            class="mobile-nav-link flex items-center justify-between rounded-xl bg-orchid/15 p-3 mb-3 text-[.92rem] font-semibold text-orchid border border-orchid/30"
            href="/services"
          >
            <span>All Services Overview</span>
            <ArrowRight className="size-4" />
          </a>

          {/* Services in Mobile */}
          <div class="space-y-1.5">
            {
              servicesList.map((service) => {
                const ServiceIcon = service.icon;
                return (
                  <a
                    class="mobile-nav-link flex items-center gap-3 rounded-xl bg-white/[0.04] px-3.5 py-2.5 border border-white/10 hover:border-orchid/40 transition-colors"
                    href={service.href}
                  >
                    <span class="grid size-7 shrink-0 place-items-center rounded-lg bg-orchid/20 text-orchid">
                      <ServiceIcon size={16} />
                    </span>
                    <span class="font-medium text-white text-base">
                      {service.title}
                    </span>
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>

      {/* 4. Mobile Solutions Accordion Section (Megamenu submenus) */}
      <div
        class="border-b border-white/20 py-3"
        id="mobile-solutions-accordion"
      >
        <button
          type="button"
          id="mobile-solutions-toggle"
          class="flex w-full items-center justify-between py-2 text-2xl font-light text-white text-left focus:outline-none"
          aria-expanded="false"
          aria-controls="mobile-solutions-submenu"
        >
          <span>Solutions</span>
          <ChevronDown
            id="mobile-solutions-caret"
            className="size-5 text-orchid transition-transform duration-300"
            aria-hidden="true"
          />
        </button>
        <div
          id="mobile-solutions-submenu"
          class="hidden pt-3 pb-2 transition-all duration-300"
        >
          {/* Solutions Sub-Items in Mobile */}
          <div class="space-y-1.5">
            {
              solutionsColumns.flat().map((sub) => (
                <a
                  class="mobile-nav-link flex items-center gap-3 rounded-xl bg-white/[0.04] px-3.5 py-2.5 border border-white/10 hover:border-orchid/40 text-white transition-colors"
                  href={sub.href}
                >
                  <ArrowRight className="size-4 text-orchid shrink-0" />
                  <span class="text-base font-medium text-white">{sub.label}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {/* 4. Mobile Portfolios */}
      <a
        class="mobile-nav-link border-b border-white/20 py-4 text-2xl font-light text-white"
        href="/portfolio"
      >
        Case Studies
      </a>

      {/* 5. Mobile Blogs */}
      <a
        class="mobile-nav-link border-b border-white/20 py-4 text-2xl font-light text-white"
        href="/blogs"
      >
        Blogs
      </a>

      {/* Mobile CTA */}
      <a
        class={`mobile-nav-link ${button} mt-6 justify-between px-6 py-4 text-base font-semibold`}
        href="/contact"
      >
        <span>Contact Us</span>
        <ArrowUpRight />
      </a>

      {/* Regional Headquarters note in Mobile */}
      <div class="mt-8 pt-4 border-t border-white/10 text-xs text-[#7f788c]">
        <p class="m-0 font-medium text-white/80">DW Tech Global Hubs</p>
        <p class="m-0 mt-1">Dubai HQ · Riyadh · Milan · Kerala</p>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile Nav Drawer Toggle
  const header = document.getElementById("site-header");
  if (header) {
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const mobileNav = document.getElementById("mobile-navigation");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      if (toggleBtn) {
        toggleBtn.setAttribute("aria-expanded", isOpen.toString());
        toggleBtn.setAttribute(
          "aria-label",
          isOpen ? "Close navigation" : "Open navigation",
        );
      }
      if (mobileNav) {
        mobileNav.setAttribute("data-open", isOpen.toString());
      }
      if (iconMenu && iconClose) {
        iconMenu.classList.toggle("hidden", isOpen);
        iconClose.classList.toggle("hidden", !isOpen);
      }

      if (isOpen) {
        document.body.dataset.menuOpen = "true";
      } else {
        delete document.body.dataset.menuOpen;
      }
    }

    if (toggleBtn) toggleBtn.addEventListener("click", toggleMenu);

    mobileNavLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isOpen) toggleMenu();
      });
    });

    // Mobile Accordion helper
    function setupMobileAccordion(
      toggleId: string,
      submenuId: string,
      caretId: string,
    ) {
      const toggle = document.getElementById(toggleId);
      const submenu = document.getElementById(submenuId);
      const caret = document.getElementById(caretId);

      if (toggle && submenu) {
        toggle.addEventListener("click", (e) => {
          e.preventDefault();
          const expanded = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", (!expanded).toString());
          submenu.classList.toggle("hidden", expanded);
          if (caret) {
            caret.classList.toggle("rotate-180", !expanded);
          }
        });
      }
    }

    setupMobileAccordion(
      "mobile-services-toggle",
      "mobile-services-submenu",
      "mobile-services-caret",
    );
    setupMobileAccordion(
      "mobile-solutions-toggle",
      "mobile-solutions-submenu",
      "mobile-solutions-caret",
    );

    // Desktop Dropdown helper
    function setupDesktopDropdown(
      triggerId: string,
      panelId: string,
      containerId: string,
    ) {
      const trigger = document.getElementById(triggerId);
      const panel = document.getElementById(panelId);
      const container = document.getElementById(containerId);

      if (!trigger || !panel || !container) return;

      const openMenu = () => {
        // Close other panels first
        document.querySelectorAll("[data-state='open']").forEach((el) => {
          if (el !== panel) el.setAttribute("data-state", "closed");
        });
        document.querySelectorAll("[aria-expanded='true']").forEach((el) => {
          if (el !== trigger && el.id.includes("-menu-trigger")) {
            el.setAttribute("aria-expanded", "false");
          }
        });

        trigger.setAttribute("aria-expanded", "true");
        panel.setAttribute("data-state", "open");
      };

      const closeMenu = () => {
        trigger.setAttribute("aria-expanded", "false");
        panel.setAttribute("data-state", "closed");
      };

      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      // Close on escape key
      container.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeMenu();
          trigger.focus();
        }
      });

      // Close if clicking outside
      document.addEventListener("click", (e) => {
        if (!container.contains(e.target as Node)) {
          closeMenu();
        }
      });
    }

    setupDesktopDropdown(
      "services-menu-trigger",
      "services-dropdown-panel",
      "services-nav-container",
    );
    setupDesktopDropdown(
      "solutions-menu-trigger",
      "solutions-dropdown-panel",
      "solutions-nav-container",
    );
  }
</script>
