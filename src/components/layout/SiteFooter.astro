---
import { Logo } from "@/components/layout/logo";
import {
  Mail,
  Phone,
  ArrowUpRight,
  LinkedIn,
  GitHub,
  WhatsApp,
} from "@/components/layout/icons";
import ScrollReveal from "@/components/animation/ScrollReveal.astro";
import { contacts, services, locations } from "@/lib/site-data";
import { button, sectionLabel, shell } from "@/lib/styles";
import QuickContactForm from "@/components/contact/quick-contact-form";
---

<footer
  class="relative overflow-hidden bg-[radial-gradient(circle_at_90%_30%,rgba(83,29,160,.26),transparent_38%),#07070b] pt-[clamp(52px,1vh,66px)] pb-7 text-white before:absolute before:top-[-260px] before:right-[-260px] before:size-[720px] before:rounded-full before:border before:border-orchid/15 before:content-[''] max-[860px]:pt-[88px] max-[620px]:pt-[76px]"
  id="contact"
>
  <div class={shell}>
    {/* CTA Section */}
    <div
      class="relative z-[1] grid grid-cols-[1.1fr_0.9fr] items-center gap-[6vw] pb-[70px] max-[960px]:grid-cols-1"
    >
      <ScrollReveal>
        <div>
          <p class={sectionLabel}>Contact</p>
          <h2
            class="text-[clamp(3.8rem,7vw,7.8rem)] max-[620px]:text-[clamp(2.8rem,13vw,4.3rem)] leading-[0.98] tracking-tight mb-6"
          >
            Let's build <span class="text-orchid">what's next.</span>
          </h2>
          <p
            class="max-w-[490px] text-[clamp(0.95rem,1.2vw,1.05rem)] leading-[1.65] text-[#c3becb] mb-6"
          >
            Tell us where your business needs to go. We'll help shape the
            technology, architecture, and intelligent systems to get there.
          </p>
        </div>
      </ScrollReveal>
      <ScrollReveal delay={0.15}>
        <QuickContactForm client:visible />
      </ScrollReveal>
    </div>

    {/* Structured Navigation & Global Footprint for SEO/GEO */}
    <ScrollReveal delay={0.1}>
      <div
        class="relative z-[1] grid grid-cols-[1fr_1.3fr_1.1fr] gap-8 border-t border-white/20 py-[40px] max-[1020px]:grid-cols-2 max-[640px]:grid-cols-1"
      >
        {/* Brand & Mission */}
        <div>
          <Logo />
          <div class="mt-4 flex flex-col gap-1 text-[.78rem] text-[#817b8f]">
            <span>Delivering Intelligent Digital Experiences</span>
          </div>
          <div class="mt-5 flex items-center gap-3">
            <a
              href="https://www.linkedin.com/company/desert-whales-technologies"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Desert Whales Technologies on LinkedIn"
              class="size-8 rounded-lg bg-white/5 border border-white/10 grid place-items-center text-white/70 hover:text-white hover:border-orchid/50 transition-all"
            >
              <LinkedIn className="size-4" />
            </a>
            <a
              href="https://github.com/desert-whales"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Desert Whales Technologies on GitHub"
              class="size-8 rounded-lg bg-white/5 border border-white/10 grid place-items-center text-white/70 hover:text-white hover:border-orchid/50 transition-all"
            >
              <GitHub className="size-4" />
            </a>
          </div>
        </div>

        {/* Core Services Links (Balanced 2 Columns) */}
        <div>
          <h4
            class="text-[.82rem] font-semibold text-orchid uppercase tracking-wider mb-3"
          >
            Services
          </h4>
          <ul
            class="grid grid-cols-2 gap-x-6 gap-y-2.5 m-0 p-0 list-none text-[.84rem] text-[#b8b3c4] max-[480px]:grid-cols-1"
          >
            {
              services.map((service) => (
                <li>
                  <a
                    href={`/services/${service.slug}`}
                    class="hover:text-white transition-colors"
                  >
                    {service.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {/* Global Locations & Direct Contact */}
        <div>
          <h4
            class="text-[.82rem] font-semibold text-orchid uppercase tracking-wider mb-3"
          >
            Global Hubs & Contact
          </h4>
          <div class="flex flex-col gap-2.5 text-[.84rem] text-[#b8b3c4]">
            <a
              href={`mailto:${contacts.email}`}
              class="flex items-center gap-2.5 hover:text-white transition-colors"
            >
              <Mail className="size-4 shrink-0 text-orchid/80" />
              <span>{contacts.email}</span>
            </a>
            <a
              href="https://wa.me/971528678679?text=Hello%20Desert%20Whales%20Tech%2C%20I%20would%20like%20to%20inquire%20about%20your%20services."
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 transition-colors font-medium"
            >
              <WhatsApp className="size-4 shrink-0 text-orchid/80" />
              <span>WhatsApp: +971 52 867 8679</span>
            </a>
            {
              contacts.phones.map(([country, number]) => (
                <a
                  href={`tel:${number.replace(/\s/g, "")}`}
                  class="flex items-center gap-2.5 hover:text-white transition-colors"
                >
                  <Phone className="size-4 shrink-0 text-orchid/80" />
                  <span>
                    {number}{" "}
                    <span class="text-[.7rem] text-[#7f7988] uppercase">
                      ({country})
                    </span>
                  </span>
                </a>
              ))
            }
            <div
              class="mt-2 pt-2 border-t border-white/10 text-[.76rem] text-[#8a8497] flex flex-wrap gap-x-3 gap-y-1"
            >
              {locations.map(([loc]) => <span>· {loc}</span>)}
            </div>
          </div>
        </div>
      </div>
    </ScrollReveal>

    {/* Footer Bottom Copyright */}
    <div
      class="relative z-[1] flex items-center justify-between border-t border-white/20 pt-[22px] text-[.74rem] text-[#77717f] max-[620px]:flex-col max-[620px]:items-start max-[620px]:gap-3.5"
    >
      <p class="m-0">
        © {new Date().getFullYear()} DW Tech. A Desert Whales Marketing Services LLC
        initiative.
      </p>
      <div class="flex gap-5">
        <a href="/services" class="hover:text-white">Services</a>
        <a href="/solutions" class="hover:text-white">Solutions</a>
        <a href="/portfolio" class="hover:text-white">Portfolio</a>
        <a href="/blogs" class="hover:text-white">Blogs</a>
        <a href="/about" class="hover:text-white">Company</a>
        <a href="/contact" class="hover:text-white">Contact</a>
      </div>
    </div>
  </div>
</footer>
