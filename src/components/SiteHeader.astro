---
import { Logo } from "@/components/logo";
import { ArrowUpRight, Close, Menu } from "@/components/icons";
import { button, shell } from "@/lib/styles";
import {
  ChevronDown,
  ArrowRight,
  CodeXml,
  Workflow,
  Sparkle,
  Cloud,
  ShieldCheck,
} from "lucide-react";

// 4 pillars matching the homepage services cards exactly (without long descriptions)
const servicesPillars = [
  {
    title: "Custom software development",
    href: "/services/custom-software-development",
    icon: CodeXml,
    subItems: [
      {
        label: "Web Applications & Mobile Applications Development",
      },
      {
        label: "ERP & CRM Solutions",
      },
      {
        label: "E-commerce platforms",
      },
      {
        label: "E-Commerce & Marketplaces",
      },
    ],
  },
  {
    title: "AI Integrated solutions & automation",
    href: "/services/ai-automation-solutions",
    icon: Workflow,
    subItems: [
      {
        label: "Generative AI & custom RAG system",
      },
      {
        label: "Workflow Automation Development",
      },
      { label: "AI agents & Automation for business" },
      { label: "AI chabots" },
    ],
  },
  {
    title: "Product Design and Development",
    href: "/services/product-design-development",
    icon: Sparkle,
    subItems: [
      { label: "UI/UX & Design Systems" },
      { label: "Mobile App Development" },
      { label: "Interactive Prototyping" },
      { label: "SaaS Product Development" },
    ],
  },
  {
    title: "Cloud and DevOps Solutions",
    href: "/services/cloud-and-devops",
    icon: Cloud,
    subItems: [
      {
        label: "Cloud Architecture & Migration",
      },
      {
        label: "CI/CD & Delivery Pipelines",
      },
      {
        label: "Infrastructure as Code (IaC)",
      },
      {
        label: "System Reliability & Security",
      },
    ],
  },
];
---

<header class="absolute top-0 left-0 z-30 w-full py-[20px]" id="site-header">
  <div
    class={`${shell} relative z-[2] grid grid-cols-[auto_1fr_auto] items-center gap-6 max-[1020px]:grid-cols-[1fr_auto]`}
  >
    {/* Logo */}
    <Logo />

    {/* Desktop Navigation - Centered, with Services right in the middle */}
    <nav
      class="hidden min-[1020px]:flex items-center justify-center gap-8 lg:gap-9"
      aria-label="Primary navigation"
    >
      {/* 1. Home */}
      <a
        class="relative grid min-h-11 place-items-center text-[.88rem] text-white/80 transition-colors duration-200 hover:text-white after:absolute after:bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-orchid after:transition-transform after:duration-250 after:ease-fluid after:content-[''] hover:after:scale-x-100"
        href="/"
      >
        Home
      </a>

      {/* 2. Company */}
      <a
        class="relative grid min-h-11 place-items-center text-[.88rem] text-white/80 transition-colors duration-200 hover:text-white after:absolute after:bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-orchid after:transition-transform after:duration-250 after:ease-fluid after:content-[''] hover:after:scale-x-100"
        href="/about"
      >
        Company
      </a>

      {
        /* 3. Services (In the exact center of navigation with clean light megamenu) */
      }
      <div class="relative group" id="services-nav-container">
        <button
          type="button"
          id="services-menu-trigger"
          class="relative flex items-center gap-1.5 py-2.5 text-[.88rem] font-medium text-white/80 transition-colors duration-200 hover:text-white focus:outline-none focus-visible:text-orchid aria-expanded:text-white group-hover:text-white"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="services-dropdown-panel"
        >
          <span>Services</span>
          <ChevronDown
            id="services-caret"
            className="size-3.5 text-white/60 transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180 [aria-expanded=true]:rotate-180"
            aria-hidden="true"
          />
        </button>

        {/* Clean, Light Mega Menu Submenu Panel */}
        <div
          id="services-dropdown-panel"
          class="invisible absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 transition-all duration-250 ease-fluid group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 data-[state=open]:visible data-[state=open]:opacity-100"
          data-state="closed"
          role="region"
          aria-label="Services Submenu"
        >
          <div
            class="w-[min(1100px,calc(100vw-36px))] overflow-hidden rounded-xl border border-black/[0.08] bg-white/98 p-6 lg:p-7 shadow-[0_25px_65px_-12px_rgba(0,0,0,0.35),0_0_1px_1px_rgba(0,0,0,0.06)] backdrop-blur-2xl text-ink"
          >
            <div
              class="grid grid-cols-4 gap-4 max-[1120px]:grid-cols-2 max-[640px]:grid-cols-1"
            >
              {
                servicesPillars.map((pillar) => {
                  const PillarIcon = pillar.icon;
                  return (
                    <div class="group/card flex flex-col justify-between rounded-xl bg-[#faf9fc] hover:bg-[#f5eefa] border border-black/[0.05] hover:border-[#7c32d5]/30 p-5 transition-all duration-200">
                      <div>
                        {/* Top header with Icon & Title */}
                        <a href={pillar.href} class="block mb-3.5">
                          <span class="grid size-10 place-items-center rounded-xl bg-[#f2e8ff] text-[#7c32d5] mb-3 transition-transform duration-300 group-hover/card:scale-105 group-hover/card:-rotate-3">
                            <PillarIcon aria-hidden="true" size={20} />
                          </span>
                          <h4 class="text-[.98rem] font-bold text-ink leading-tight tracking-[-0.02em] min-h-[38px] group-hover/card:text-[#7c32d5] transition-colors">
                            {pillar.title}
                          </h4>
                        </a>

                        {/* Sub-menu items for each service */}
                        <div class="border-t border-black/[0.06] pt-3">
                          <ul class="flex flex-col gap-1.5 m-0 p-0 list-none text-[.78rem] font-bold text-[#8b8496]">
                            {pillar.subItems.map((sub) => (
                              <li class="leading-snug" title={sub.label}>
                                <span class="truncate block font-medium hover:text-[#7c32d5] transition-colors">
                                  {sub.label}
                                </span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  );
                })
              }
            </div>

            {/* Clean bottom strip */}
            <div
              class="mt-5 flex items-center justify-between rounded-xl bg-[#f2eef8] px-4 py-3 border border-black/[0.04] text-xs text-[#5e5868] max-[780px]:flex-col max-[780px]:items-start max-[780px]:gap-2"
            >
              <div class="flex items-center gap-2">
                <ShieldCheck className="size-4 text-[#7c32d5]" />
                <span
                  >Dubai Global HQ · Serving UAE, Saudi Arabia, Europe & India
                  with enterprise compliance</span
                >
              </div>
              <a
                href="/#contact"
                class="inline-flex items-center gap-1 text-[.76rem] font-bold text-[#7c32d5] hover:underline"
              >
                <span>Consult an Architect</span>
                <ArrowRight className="size-3" />
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* 4. Portfolios */}
      <a
        class="relative grid min-h-11 place-items-center text-[.88rem] text-white/80 transition-colors duration-200 hover:text-white after:absolute after:bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-orchid after:transition-transform after:duration-250 after:ease-fluid after:content-[''] hover:after:scale-x-100"
        href="/portfolio"
      >
        Portfolios
      </a>

      {/* 5. Blogs */}
      <a
        class="relative grid min-h-11 place-items-center text-[.88rem] text-white/80 transition-colors duration-200 hover:text-white after:absolute after:bottom-1.5 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-orchid after:transition-transform after:duration-250 after:ease-fluid after:content-[''] hover:after:scale-x-100"
        href="/blogs"
      >
        Blogs
      </a>
    </nav>

    {/* Action CTA */}
    <a
      class="hidden min-[1020px]:flex items-center p-1 gap-3 justify-self-end text-[.9rem]"
      href="mailto:tech@thedesertwhales.com?subject=New%20project%20enquiry"
    >
      <span class="cta-link-text" data-text="Start a Conversation"
        >Start a Conversation</span
      >
      <span class={`${button}`}>
        <ArrowUpRight />
      </span>
    </a>

    {/* Mobile Hamburger Toggle Button */}
    <button
      id="mobile-menu-toggle"
      class="hidden size-11 cursor-pointer place-items-center justify-self-end rounded-lg border border-white/20 bg-transparent p-2.5 max-[1020px]:grid [&_svg]:size-[22px] [&_svg]:fill-none [&_svg]:stroke-current [&_svg]:stroke-[1.6] [&_svg]:[stroke-linecap:round]"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-label="Open navigation"
    >
      <div id="icon-menu"><Menu /></div>
      <div id="icon-close" class="hidden"><Close /></div>
    </button>
  </div>

  {/* Mobile Navigation Drawer */}
  <div
    id="mobile-navigation"
    class="invisible fixed inset-0 z-[1] h-svh w-full -translate-y-full overflow-y-auto bg-night pt-[88px] opacity-0 transition-[opacity,transform,visibility] duration-350 ease-fluid data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100"
    data-open="false"
  >
    <nav
      class="flex min-h-0 flex-col gap-1 px-[clamp(20px,4.2vw,72px)] pb-12 max-[620px]:px-5"
      aria-label="Mobile navigation"
    >
      {/* 1. Mobile Home */}
      <a
        class="mobile-nav-link border-b border-white/20 py-4 text-2xl font-light text-white"
        href="/"
      >
        Home
      </a>

      {/* 2. Mobile Company */}
      <a
        class="mobile-nav-link border-b border-white/20 py-4 text-2xl font-light text-white"
        href="/about"
      >
        Company
      </a>

      {/* 3. Mobile Services Accordion Section */}
      <div class="border-b border-white/20 py-3" id="mobile-services-accordion">
        <button
          type="button"
          id="mobile-services-toggle"
          class="flex w-full items-center justify-between py-2 text-2xl font-light text-white text-left focus:outline-none"
          aria-expanded="false"
          aria-controls="mobile-services-submenu"
        >
          <span>Services</span>
          <ChevronDown
            id="mobile-services-caret"
            className="size-5 text-orchid transition-transform duration-300"
            aria-hidden="true"
          />
        </button>
        <div
          id="mobile-services-submenu"
          class="hidden pt-3 pb-2 transition-all duration-300"
        >
          <a
            class="mobile-nav-link flex items-center justify-between rounded-xl bg-orchid/15 p-3 mb-4 text-[.92rem] font-semibold text-orchid border border-orchid/30"
            href="/services"
          >
            <span>All Services Overview</span>
            <ArrowRight className="size-4" />
          </a>

          {/* 4 Pillars in Mobile without long descriptions */}
          <div class="space-y-3">
            {
              servicesPillars.map((pillar) => (
                <div class="rounded-xl bg-white/[0.04] p-3.5 border border-white/10">
                  <a
                    class="mobile-nav-link flex items-center justify-between font-semibold text-white text-base mb-2"
                    href={pillar.href}
                  >
                    <span>{pillar.title}</span>
                    <ArrowRight className="size-3.5 text-orchid" />
                  </a>
                  <ul class="flex flex-col gap-1.5 m-0 p-0 list-none text-xs text-[#c9c4d5]">
                    {pillar.subItems.map((sub) => (
                      <li class="leading-snug" title={sub.label}>
                        <span class="truncate block">{sub.label}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      {/* 4. Mobile Portfolios */}
      <a
        class="mobile-nav-link border-b border-white/20 py-4 text-2xl font-light text-white"
        href="/portfolio"
      >
        Portfolios
      </a>

      {/* 5. Mobile Blogs */}
      <a
        class="mobile-nav-link border-b border-white/20 py-4 text-2xl font-light text-white"
        href="/blogs"
      >
        Blogs
      </a>

      {/* Mobile CTA */}
      <a
        class={`mobile-nav-link ${button} mt-6 justify-between px-6 py-4 text-base font-semibold`}
        href="mailto:tech@thedesertwhales.com?subject=New%20project%20enquiry"
      >
        <span>Start a conversation</span>
        <ArrowUpRight />
      </a>

      {/* Regional Headquarters note in Mobile */}
      <div class="mt-8 pt-4 border-t border-white/10 text-xs text-[#7f788c]">
        <p class="m-0 font-medium text-white/80">DW Tech Global Hubs</p>
        <p class="m-0 mt-1">Dubai HQ · Riyadh · Milan · Kerala</p>
      </div>
    </nav>
  </div>
</header>

<script>
  // Mobile Nav Drawer Toggle
  const header = document.getElementById("site-header");
  if (header) {
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const mobileNav = document.getElementById("mobile-navigation");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      if (toggleBtn) {
        toggleBtn.setAttribute("aria-expanded", isOpen.toString());
        toggleBtn.setAttribute(
          "aria-label",
          isOpen ? "Close navigation" : "Open navigation",
        );
      }
      if (mobileNav) {
        mobileNav.setAttribute("data-open", isOpen.toString());
      }
      if (iconMenu && iconClose) {
        iconMenu.classList.toggle("hidden", isOpen);
        iconClose.classList.toggle("hidden", !isOpen);
      }

      if (isOpen) {
        document.body.dataset.menuOpen = "true";
      } else {
        delete document.body.dataset.menuOpen;
      }
    }

    if (toggleBtn) toggleBtn.addEventListener("click", toggleMenu);

    mobileNavLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isOpen) toggleMenu();
      });
    });

    // Mobile Services Accordion Toggle
    const mobileServicesToggle = document.getElementById(
      "mobile-services-toggle",
    );
    const mobileServicesSubmenu = document.getElementById(
      "mobile-services-submenu",
    );
    const mobileServicesCaret = document.getElementById(
      "mobile-services-caret",
    );

    if (mobileServicesToggle && mobileServicesSubmenu) {
      mobileServicesToggle.addEventListener("click", (e) => {
        e.preventDefault();
        const expanded =
          mobileServicesToggle.getAttribute("aria-expanded") === "true";
        mobileServicesToggle.setAttribute(
          "aria-expanded",
          (!expanded).toString(),
        );
        mobileServicesSubmenu.classList.toggle("hidden", expanded);
        if (mobileServicesCaret) {
          mobileServicesCaret.classList.toggle("rotate-180", !expanded);
        }
      });
    }

    // Desktop Services Dropdown Accessibility & Click/Keyboard Toggle
    const desktopServicesTrigger = document.getElementById(
      "services-menu-trigger",
    );
    const desktopServicesPanel = document.getElementById(
      "services-dropdown-panel",
    );
    const desktopServicesContainer = document.getElementById(
      "services-nav-container",
    );

    if (
      desktopServicesTrigger &&
      desktopServicesPanel &&
      desktopServicesContainer
    ) {
      const openDesktopMenu = () => {
        desktopServicesTrigger.setAttribute("aria-expanded", "true");
        desktopServicesPanel.setAttribute("data-state", "open");
      };

      const closeDesktopMenu = () => {
        desktopServicesTrigger.setAttribute("aria-expanded", "false");
        desktopServicesPanel.setAttribute("data-state", "closed");
      };

      desktopServicesTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isExpanded =
          desktopServicesTrigger.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          closeDesktopMenu();
        } else {
          openDesktopMenu();
        }
      });

      // Close on escape key
      desktopServicesContainer.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeDesktopMenu();
          desktopServicesTrigger.focus();
        }
      });

      // Close if clicking outside
      document.addEventListener("click", (e) => {
        if (!desktopServicesContainer.contains(e.target as Node)) {
          closeDesktopMenu();
        }
      });
    }
  }
</script>
